// Numeric fuzz: 4000 pseudo-random 64-bit values, pushed through integer
// arithmetic, shifts, narrowing casts, float and double arithmetic, casts back
// to integers, and every way a number becomes text. Java prints the oracle.
//
// The generator is a 64-bit LCG with wrapping multiply and add, so both
// languages walk the same sequence. Every double is built only from exact
// IEEE operations (integer to double, `* 10.0`, `/ 10.0`, `/ 1e300`), which
// both languages perform bit for bit, so any difference in the output is a
// difference in how a value is computed, converted or printed.

public void main() {
    long x = 88172645463325252L;
    for (int i = 0; i < 4000; i++) {
        x = x *% 6364136223846793005L +% 1442695040888963407L;
        int k = (int) ((x >> 3) & 63L);
        i32 small = (i32) (x >> 40);
        double m = (double) (x >> 11);
        double v = m;
        for (int j = 0; j < k; j++) {
            if ((x & 1L) == 0L) {
                v = v * 10.0;
            } else {
                v = v / 10.0;
            }
        }
        if ((x & 30L) == 6L) {
            v = v / 1e300;
        }
        if ((x & 62L) == 14L) {
            v = v / 1e300 / 1e300;
        }
        float f = (float) v;

        print(x);
        print(x / 7L);
        print(x % 1000L);
        print(x >> k);
        print(x << k);
        print((i32) x);
        print((short) x);
        print((byte) x);
        print(small / 3);
        print(small % 5);
        print(small + x);
        print(v);
        print(f);
        print(-v);
        print(v * 0.1);
        print(f * 3.0f);
        print(k + v);
        print(small * 1.5);
        print((long) v);
        print((i32) v);
        print((long) f);
        print((double) f);
        print(v.floor());
        print(v.ceil());
        print(v.abs().sqrt());
        print(v < m);
        print(v == m);
        print("v=" + v);
        print($"f=${f} v=${v}");
    }
}

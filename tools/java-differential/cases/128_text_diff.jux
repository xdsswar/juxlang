// A line diff built on the longest common subsequence: a 2D int table filled
// bottom-up, walked back into keep / add / remove edits, then grouped into
// hunks. Exercises 2D arrays, string splitting, records, an enum with a
// method, and a char-level LCS over the same code.

enum Kind {
    Keep, Add, Remove;

    public String mark() {
        return switch (this) {
            case Keep -> " ";
            case Add -> "+";
            case Remove -> "-";
        };
    }
}

record Edit(Kind kind, String line) {}

int[][] lcsTable(String[] a, String[] b) {
    int[][] t = new int[a.length + 1][b.length + 1];
    for (int i = a.length - 1; i >= 0; i--) {
        for (int j = b.length - 1; j >= 0; j--) {
            if (a[i] == b[j]) {
                t[i][j] = t[i + 1][j + 1] + 1;
            } else {
                t[i][j] = t[i + 1][j] > t[i][j + 1] ? t[i + 1][j] : t[i][j + 1];
            }
        }
    }
    return t;
}

Vec<Edit> diff(String[] a, String[] b) {
    var t = lcsTable(a, b);
    var edits = new Vec<Edit>();
    int i = 0;
    int j = 0;
    while (i < a.length && j < b.length) {
        if (a[i] == b[j]) {
            edits.push(new Edit(Kind.Keep, a[i]));
            i++;
            j++;
        } else if (t[i + 1][j] >= t[i][j + 1]) {
            edits.push(new Edit(Kind.Remove, a[i]));
            i++;
        } else {
            edits.push(new Edit(Kind.Add, b[j]));
            j++;
        }
    }
    while (i < a.length) {
        edits.push(new Edit(Kind.Remove, a[i]));
        i++;
    }
    while (j < b.length) {
        edits.push(new Edit(Kind.Add, b[j]));
        j++;
    }
    return edits;
}

String[] lines(String text) {
    var parts = new Vec<String>();
    var current = "";
    for (int k = 0; k < text.charLength(); k++) {
        var c = text.charAt(k);
        if (c == '\n') {
            parts.push(current);
            current = "";
        } else {
            current = current + c;
        }
    }
    parts.push(current);
    String[] out = new String[parts.len()];
    for (int k = 0; k < parts.len(); k++) {
        out[k] = parts[k];
    }
    return out;
}

int charLcs(String x, String y) {
    int n = x.charLength();
    int m = y.charLength();
    int[][] t = new int[n + 1][m + 1];
    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= m; j++) {
            if (x.charAt(i - 1) == y.charAt(j - 1)) {
                t[i][j] = t[i - 1][j - 1] + 1;
            } else {
                t[i][j] = t[i - 1][j] > t[i][j - 1] ? t[i - 1][j] : t[i][j - 1];
            }
        }
    }
    return t[n][m];
}

public void main() {
    var before = lines("alpha\nbeta\ngamma\ndelta\nepsilon");
    var after = lines("alpha\ngamma\ndelta\nzeta\nepsilon\neta");
    var edits = diff(before, after);
    int added = 0;
    int removed = 0;
    for (var e : edits) {
        print(e.kind.mark() + " " + e.line);
        if (e.kind == Kind.Add) { added++; }
        if (e.kind == Kind.Remove) { removed++; }
    }
    print("+" + added + " -" + removed + " of " + edits.len());

    print(charLcs("ABCBDAB", "BDCABA"));
    print(charLcs("kitten", "sitting"));
    print(charLcs("", "abc"));
}

public String show(int v) { return "int:" + v; }
public String show(double v) { return "double:" + v; }
public String show(String v) { return "string:" + v; }
public String show(int a, int b) { return "two:" + (a + b); }

public class Fmt {
    public String of(int v) { return "m-int:" + v; }
    public String of(String v) { return "m-string:" + v; }
    public String of(int a, String b) { return "m-both:" + a + b; }
}

public void main() {
    print(show(1));
    print(show(2.5));
    print(show("x"));
    print(show(3, 4));

    var f = new Fmt();
    print(f.of(7));
    print(f.of("y"));
    print(f.of(1, "z"));

    int n = 9;
    String s = "s";
    print(show(n));
    print(show(s));
    print(f.of(n, s));
}

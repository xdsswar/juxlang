public void main() {
    String s = "Hello, World";
    print(s.length());
    print(s.toUpperCase());
    print(s.toLowerCase());
    print(s.substring(0, 5));
    print(s.substring(7));
    print(s.indexOf("World"));
    print(s.indexOf("zzz"));
    print(s.contains("lo,"));
    print(s.startsWith("Hell"));
    print(s.endsWith("rld"));
    print(s.replace("World", "Jux"));
    print(s.trim());
    print("  pad  ".trim());
    print(s.charAt(1));
    print(s.isEmpty());
    print("".isEmpty());
    print("a" + 1 + 2);
    print(1 + 2 + "a");
    print(s == "Hello, World");
    print("apple" < "banana");
    print("banana" < "apple");
}

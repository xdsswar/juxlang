public void main() {
    print(2 + 3 * 4);
    print((2 + 3) * 4);
    print(10 - 4 - 3);
    print(100 / 10 / 2);
    print(2 + 3 > 4);
    print(1 < 2 == true);
    print(!(1 > 2));
    print(1 + 2 == 3 && 4 > 3);
    print(true || false && false);
    print((true || false) && false);
    print(5 % 3 * 2);
    print(-3 + 4);
    print(- (3 + 4));
    print(1 << 2 + 1);
    print((1 << 2) + 1);
    print(7 & 3 | 4);
    print(7 & (3 | 4));
    int a = 2;
    int b = 3;
    int c = 4;
    print(a + b * c - a);
    print(a * b % c);
    print(a < b == b < c);
    bool t = a < b;
    print(t ? "lt" : "ge");
    print(a == 2 ? b : c);
}

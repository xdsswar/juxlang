// `new T[][] { {…}, {…} }`: the explicit-type form of a multi-dimensional
// array literal (JUX-LANG-V1 §5.6).
//
// The bare `{{…}, {…}}` form has always parsed in a typed local. The `new`
// form only accepted one dimension, so a matrix built inside a `return` or
// passed straight to a constructor did not.

class Matrix {
    private double[][] cells;

    public Matrix(double[][] cells) {
        this.cells = cells;
    }

    public static Matrix identity() {
        return new Matrix(new double[][] {
            {1.0, 0.0},
            {0.0, 1.0}
        });
    }

    public double at(int row, int column) {
        return cells[row][column];
    }
}

void main() {
    // In a local, with the type written out.
    var m = new int[][] {{1, 2}, {3, 4}};
    print(m[0][1]);
    print(m[1][0]);
    print(m.length);
    print(m[0].length);

    // Three dimensions, and a trailing comma.
    var cube = new int[][][] {
        {{1, 2}, {3, 4}},
        {{5, 6}, {7, 8}},
    };
    print(cube[1][0][1]);

    // Straight into a constructor, and out of a static method.
    print(Matrix.identity().at(0, 0));
    print(Matrix.identity().at(0, 1));
    print(new Matrix(new double[][] {{2.0, 0.0}, {0.0, 2.0}}).at(1, 1));

    // The bare form still means the same thing.
    int[][] bare = {{9, 8}, {7, 6}};
    print(bare[1][1]);
}

package app.model;

/**
 * An ordinary class with the same name as `app.errors.Failure`. It is a
 * shared, mutable object like any other class: an alias sees the change.
 */
public class Failure {
    public String reason;
    public int count;

    public Failure(String reason) {
        this.reason = reason;
        this.count = 0;
    }

    public void bump() {
        count = count + 1;
    }
}

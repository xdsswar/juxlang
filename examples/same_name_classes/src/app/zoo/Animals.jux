package app.zoo;

/** A polymorphic base, named like the one in `app.garage`. */
public class Base {
    public String name;

    public Base(String name) {
        this.name = name;
    }

    public String describe() {
        return "animal " + name;
    }
}

public class Cat extends Base {
    public int lives;

    public Cat(String name) {
        super(name);
        this.lives = 9;
    }

    public String describe() {
        return "cat " + name + " with " + lives + " lives";
    }

    public void loseLife() {
        lives = lives - 1;
    }
}

/** A nested class named like the one in `app.garage.Pen`. */
public class Pen {
    public class Gate {
        public bool open;

        public Gate() {
            this.open = false;
        }
    }

    public Gate gate = new Gate();
}

// §M.13 ref bindings — shared references to value types.
package refb;

void rename(ref String name) {
    name = "renamed";          // the CALLER's object changes
}

void bump(ref int n) {
    n += 5;
}

int readOnly(ref int n) {
    return n * 2;
}

// A parameter is a variable of this body like any other, so a `ref` taken
// from it aliases it here (ERRATA E86). The caller is untouched: the
// parameter itself was filled with a copy.
int aliasParam(int seed) {
    ref int r = seed;
    r = seed + 1;
    return seed;
}

public void main() {
    // Locals: alias + store-through.
    ref String a = "first";
    ref String b = a;          // b aliases a's object
    b = "second";
    print("a: " + a);          // "second"

    // Write-through a ref param.
    rename(a);
    print("b: " + b);          // "renamed" — same object throughout

    // Primitives.
    ref int n = 10;
    ref int m = n;
    bump(n);
    print("m: " + m);          // 15
    print("double: " + readOnly(m));

    // Self-referential store-through (RHS reads the same cell).
    n = n + 1;
    print("n: " + n);          // 16

    // Plain value into a ref param: fresh object, caller unaffected.
    String plain = "keep";
    rename(plain);
    print("plain: " + plain);  // "keep"

    // Plain read out of a ref into a value local: a copy.
    String copy = a;
    a = "changed";
    print("copy: " + copy);    // "renamed"

    // A `ref` taken from a plain LOCAL aliases that local (ERRATA E86, and
    // the worked example in JUX-POINTERS-REFERENCES-GUIDE §2.2): the local
    // IS the shared object from here on, so a write through either name is
    // seen by both.
    int total = 0;
    ref int acc = total;
    acc = 5;
    print("total: " + total);  // 5
    total = 9;
    print("acc: " + acc);      // 9

    // The same, on a String.
    String label = "one";
    ref String labelAlias = label;
    labelAlias = "two";
    print("label: " + label);  // "two"

    // A ref taken from a PARAMETER aliases it inside the callee only.
    print("param: " + aliasParam(5));  // 6

    print("done");
}

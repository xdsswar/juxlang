// `String` and `string` are the SAME type (§5.5), as in C#. Either spelling
// works in any type position, they interoperate freely, and `typeof` echoes
// the canonical `String` whichever was written.
public class Greeter {
    private string name;
    public Greeter(string name) { this.name = name; }
    public String greet(string suffix) { return "hi " + this.name + suffix; }
}

public void main() {
    string a = "world";
    String b = "!";
    var g = new Greeter(a);
    print(g.greet(b) + "\n");
    print(typeof(a) + " " + typeof(b) + "\n");
}

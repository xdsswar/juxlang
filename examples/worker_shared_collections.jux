// Collections of an object shared with workers (ERRATA E145, E1XX-SWEEPA).
//
// A class whose objects cross a worker boundary is shared between threads,
// and so are the collections it holds (JUX-LANG-V1 §6.5.1): each is one
// collection behind a thread-safe handle, whatever name reaches it. A method
// that adds to it, a mutating call on the field itself (`reg.items.push(x)`),
// a getter's result, a field bound to a local and a list handed in are all the
// SAME list, and a write through any of them is seen through every other, as
// in Java. Before E1XX-SWEEPA what was read out was a copy, and writing it was
// `E0702`.
//
// DIFFERENTIAL: tools/java-differential/cases/157_worker_shared_collections

import rust.std.*;

class Registry {
    private Vec<String> log = new Vec<String>();
    public Vec<String> items = new Vec<String>();
    public void handle(String s) { this.log.push(s); }
    public void addAll(Vec<String> more) { for (var m : more) { this.log.push(m); } }
    public Vec<String> getLog() { return this.log; }
    public Vec<String> fresh() { var v = new Vec<String>(); v.push("f"); return v; }
    public int count() { return this.log.len(); }
}

public int work(Registry r, String tag, int n) {
    for (int i = 0; i < n; i++) { r.handle(tag); }
    r.items.push(tag);
    return n;
}

public async void main() {
    var r = new Registry();
    var a = Worker.spawn(() -> work(r, "a", 3));
    var b = Worker.spawn(() -> work(r, "b", 2));
    await a;
    await b;
    print(r.count() + " " + r.items.len());

    var more = new Vec<String>();
    more.push("c");
    more.push("d");
    r.addAll(more);
    var log = r.getLog();
    print(log.len());
    var total = 0;
    for (var s : log) { total += s.length(); }
    print(total);
    log.push("z");
    print(r.count());

    r.items.push("main");
    var items = r.items;
    print(items.len() + " " + r.items.len());
    items.push("alias");
    print(r.items.len());

    r.items = more;
    print(r.items.len() + " " + more.len());
    more.push("e");
    r.items.push("f");
    print(r.items.len() + " " + more.len());

    var f = r.fresh();
    f.push("mine");
    var c = r.getLog().clone();
    c.push("extra");
    print(f.len() + " " + c.len() + " " + r.count());
}

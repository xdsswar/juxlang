// The console: which view, what is selected, and where a click lands.
//
// This is the only file that knows the dashboard's shape. A widget knows how
// to draw itself into a rectangle and nothing about its neighbours, so moving
// a panel is an edit here and nowhere else.
//
// It is also the only file that handles input. A widget that can be clicked
// records the rectangles it drew into a shared HitMap; the console asks the
// map what is under a point and turns the answer into state. The window front
// end therefore forwards coordinates and nothing more, which is what lets the
// same interaction be driven by a test with no mouse attached.

package demo.render;

import demo.core.Latest;
import demo.core.Mean;
import demo.core.Peak;
import demo.core.Ring;
import demo.model.Fleet;
import demo.model.Host;
import demo.model.Severity;

public class Console {
    private Fleet fleet;
    private Theme theme;
    private Text text;
    private HitMap hits;

    private View view;
    private String? selected;
    private String? hovered;
    private bool light;

    public Console(Fleet fleet, Theme theme) {
        this.fleet = fleet;
        this.theme = theme;
        this.text = new Text();
        this.hits = new HitMap();
        this.view = View.Overview;
        this.selected = null;
        this.hovered = null;
        this.light = theme.name() == "paper";
    }

    public Fleet fleet() { return this.fleet; }
    public Theme theme() { return this.theme; }
    public View view() { return this.view; }
    public String? selected() { return this.selected; }

    public void setTheme(Theme theme) {
        this.theme = theme;
        this.light = theme.name() == "paper";
    }

    /// Switch palettes. The chip in the tab bar and the T key both land
    /// here, so there is one implementation and both routes exercise it.
    public void toggleTheme() {
        this.light = !this.light;
        this.theme = this.light ? Theme.paper() : Theme.midnight();
    }
    public void setView(View view) { this.view = view; }

    /// Select a host by name. Ignores a name the fleet does not know, so a
    /// stale selection cannot outlive the host it named.
    public bool select(String name) {
        if (this.fleet.byName(name) == null) {
            return false;
        }
        this.selected = name;
        return true;
    }

    // ---- input -------------------------------------------------------

    /// Handle a click. Returns true when it changed something, so a caller
    /// that redraws only on change can ask.
    public bool click(int x, int y) {
        var action = this.hits.at(x, y);
        if (action == null) {
            return false;
        }
        return this.apply(action!!);
    }

    /// Track the cursor. Returns true when the highlighted region changed.
    public bool hover(int x, int y) {
        var found = this.hits.at(x, y);
        if (found == null && this.hovered == null) {
            return false;
        }
        if (found != null && this.hovered != null && found!! == this.hovered!!) {
            return false;
        }
        this.hovered = found;
        return true;
    }

    /// Turn an action string into state. One place, so a widget never has to
    /// know what its own regions mean.
    private bool apply(String action) {
        var asView = View.fromAction(action);
        if (asView != null) {
            if (this.view == asView!!) {
                return false;
            }
            this.view = asView!!;
            return true;
        }
        if (action == "theme") {
            this.toggleTheme();
            return true;
        }
        if (action.startsWith("host:")) {
            var name = action.substring(5, action.length());
            if (!this.select(name)) {
                return false;
            }
            // Picking a host is a request to look at it.
            this.view = View.Detail;
            return true;
        }
        return false;
    }

    // ---- rendering ---------------------------------------------------

    public void render(Canvas c) {
        var t = this.theme;
        c.clear(t.background());
        this.hits.clear();

        // A selection that never happened, or one whose host has gone: fall
        // back to the busiest, so every view has something to show.
        if (this.selected == null || this.fleet.byName(this.selected!!) == null) {
            var busiest = this.busiest();
            this.selected = busiest == null ? null : busiest!!.name();
        }

        int pad = 12;
        int headerH = 34;
        int footerH = 20;
        this.header(c, pad, pad, c.width() - pad * 2, headerH);

        int top = pad + headerH + pad;
        int bodyH = c.height() - top - pad - footerH;
        int bodyW = c.width() - pad * 2;

        switch (this.view) {
            case View.Overview -> this.overview(c, pad, top, bodyW, bodyH);
            case View.Hosts -> this.hostList(c, pad, top, bodyW, bodyH);
            case View.Detail -> this.detail(c, pad, top, bodyW, bodyH);
        }

        this.footer(c, pad, top + bodyH + 4, bodyW, footerH);
    }

    /// Title, tab bar, and the fleet's worst level.
    private void header(Canvas c, int x, int y, int w, int h) {
        var t = this.theme;
        c.rect(x, y, w, h, t.panel());
        c.frame(x, y, w, h, t.grid());

        this.text.drawScaled(c, "JUX METRICS", x + 8, y + 8, t.ink(), 2);

        // Tabs drawn from the enum's own variants, so a new view is a new tab
        // and no list here has to be kept in step. Each registers the
        // rectangle it drew.
        int tabX = x + 152;
        for (var v : View.values()) {
            var label = v.label().toUpperCase();
            int tw = this.text.widthOf(label, 1) + 18;
            bool active = this.view == v;
            bool warm = this.hovered != null && this.hovered!! == v.action();

            int fill = active ? t.accent() : (warm ? t.grid() : t.panel());
            c.rect(tabX, y + 6, tw, h - 12, fill);
            c.frame(tabX, y + 6, tw, h - 12, t.grid());
            this.text.draw(c, label, tabX + 9, y + 12,
                           active ? t.background() : t.ink());
            this.hits.add(tabX, y + 6, tw, h - 12, v.action());
            tabX = tabX + tw + 6;
        }

        // The theme chip sits after the tabs, so every control on the
        // console is in one row and every one of them is clickable.
        var themeLabel = this.theme.name().toUpperCase();
        int themeW = this.text.widthOf(themeLabel, 1) + 18;
        bool themeWarm = this.hovered != null && this.hovered!! == "theme";
        c.rect(tabX + 10, y + 6, themeW, h - 12, themeWarm ? t.grid() : t.panel());
        c.frame(tabX + 10, y + 6, themeW, h - 12, t.grid());
        this.text.draw(c, themeLabel, tabX + 19, y + 12, t.inkDim());
        this.hits.add(tabX + 10, y + 6, themeW, h - 12, "theme");

        var worst = this.fleet.worst();
        int warn = this.fleet.countAtLeast(Severity.Warn);
        var status = worst.name().toUpperCase() + "  " + warn + "/" + this.fleet.size();
        int sw = this.text.widthOf(status, 1);
        this.text.draw(c, status, x + w - sw - 24, y + 13, worst.colour());
        c.rect(x + w - 16, y + 12, 8, 8, worst.colour());
    }

    /// A hint line, and whatever the cursor is over.
    private void footer(Canvas c, int x, int y, int w, int h) {
        var t = this.theme;
        var hint = "CLICK A TAB, A THEME, OR A HOST    SPACE PAUSE    ESC CLOSE";
        this.text.draw(c, hint, x, y + 6, t.inkDim());

        if (this.hovered != null) {
            var label = this.hovered!!.toUpperCase();
            int lw = this.text.widthOf(label, 1);
            this.text.draw(c, label, x + w - lw, y + 6, t.accent());
        }
    }

    // ---- the three views ---------------------------------------------

    /// The fleet at a glance: a clickable table, the selected host's two
    /// percentage charts, and three aggregates over one window.
    private void overview(Canvas c, int x, int y, int w, int h) {
        var t = this.theme;
        int pad = 12;
        int leftW = (w - pad) * 3 / 5;
        int rightW = w - pad - leftW;
        int rightX = x + leftW + pad;

        int tableH = 26 + this.fleet.size() * 12;
        int tableCap = h * 3 / 5;
        if (tableH > tableCap) {
            tableH = tableCap;
        }
        new FleetTable(this.fleet, this.hits, this.selected, this.hovered)
            .render(c, t, this.text, x, y, leftW, tableH);

        var host = this.selectedHost();
        if (host != null) {
            int chartTop = y + tableH + pad;
            int chartH = h - tableH - pad;
            int cpuH = (chartH - pad) * 3 / 5;

            new Sparkline(host!!.name() + " cpu", host!!.cpu().window(), 100)
                .render(c, t, this.text, x, chartTop, leftW, cpuH);
            new Sparkline(host!!.name() + " mem", host!!.memory().window(), 100)
                .render(c, t, this.text, x, chartTop + cpuH + pad,
                        leftW, chartH - cpuH - pad);
        }

        int cell = 58;
        int used = 0;
        if (host != null) {
            var window = host!!.cpu().window();
            new Readout("now", window, new Latest())
                .render(c, t, this.text, rightX, y, rightW, cell);
            new Readout("mean", window, new Mean())
                .render(c, t, this.text, rightX, y + cell + pad, rightW, cell);
            new Readout("peak", window, new Peak())
                .render(c, t, this.text, rightX, y + (cell + pad) * 2, rightW, cell);
            used = (cell + pad) * 3;
        }

        var regions = this.fleet.byRegion();
        int regionH = 26 + regions.len() * 14;
        new RegionBreakdown(regions)
            .render(c, t, this.text, rightX, y + used, rightW, regionH);

        if (host != null) {
            int tailTop = y + used + regionH + pad;
            new Sparkline("p99 latency ms", host!!.latency().window(), 320)
                .render(c, t, this.text, rightX, tailTop, rightW, y + h - tailTop);
        }
    }

    /// Every host, with all three readings side by side. The row is the
    /// clickable thing here, and it gets the full width.
    private void hostList(Canvas c, int x, int y, int w, int h) {
        var t = this.theme;
        int pad = 12;

        int tableH = HostTable.heightFor(this.fleet.size());
        if (tableH > h) {
            tableH = h;
        }
        new HostTable(this.fleet, this.hits, this.selected, this.hovered)
            .render(c, t, this.text, x, y, w, tableH);

        // Whatever the table did not need answers the two questions it
        // raises: where the fleet is, and what the selected host has done.
        int restY = y + tableH + pad;
        int restH = y + h - restY;
        if (restH < 60) {
            return;
        }
        int leftW = (w - pad) * 2 / 5;
        new RegionBreakdown(this.fleet.byRegion())
            .render(c, t, this.text, x, restY, leftW, restH);

        var host = this.selectedHost();
        if (host != null) {
            new Sparkline(host!!.name() + " cpu", host!!.cpu().window(), 100)
                .render(c, t, this.text, x + leftW + pad, restY,
                        w - leftW - pad, restH);
        }
    }

    /// One host, in full: three charts and three aggregates.
    private void detail(Canvas c, int x, int y, int w, int h) {
        var t = this.theme;
        int pad = 12;
        var host = this.selectedHost();
        if (host == null) {
            new Readout("no host", new Ring<int>(1), new Latest())
                .render(c, t, this.text, x, y, w, 58);
            return;
        }

        int rightW = 236;
        int leftW = w - rightW - pad;
        int chartH = (h - pad * 2) / 3;

        new Sparkline(host!!.name() + " cpu %", host!!.cpu().window(), 100)
            .render(c, t, this.text, x, y, leftW, chartH);
        new Sparkline(host!!.name() + " mem %", host!!.memory().window(), 100)
            .render(c, t, this.text, x, y + chartH + pad, leftW, chartH);
        new Sparkline(host!!.name() + " p99 ms", host!!.latency().window(), 320)
            .render(c, t, this.text, x, y + (chartH + pad) * 2, leftW, chartH);

        int rightX = x + leftW + pad;
        new Readout("cpu now", host!!.cpu().window(), new Latest())
            .render(c, t, this.text, rightX, y, rightW, chartH);
        new Readout("mem mean", host!!.memory().window(), new Mean())
            .render(c, t, this.text, rightX, y + chartH + pad, rightW, chartH);
        new Readout("p99 peak", host!!.latency().window(), new Peak(), 320)
            .render(c, t, this.text, rightX, y + (chartH + pad) * 2, rightW, chartH);
    }

    // ---- helpers -----------------------------------------------------

    /// The selected host, or null on an empty fleet.
    private Host? selectedHost() {
        if (this.selected == null) {
            return null;
        }
        return this.fleet.byName(this.selected!!);
    }

    /// The host with the highest current cpu, or null on an empty fleet.
    private Host? busiest() {
        Host? best = null;
        int bestPct = -1;
        for (var h : this.fleet.all()) {
            if (h.cpu().isEmpty()) {
                continue;
            }
            int pct = h.cpu().window().last();
            if (pct > bestPct) {
                bestPct = pct;
                best = h;
            }
        }
        return best;
    }
}

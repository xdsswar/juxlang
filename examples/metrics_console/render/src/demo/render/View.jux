// Which screen the console is showing.
//
// An enum rather than a string so a new view is a compile error everywhere
// that switches on one, and so the tab bar can draw itself from `values()`
// instead of a list someone has to remember to update.

package demo.render;

public enum View {
    Overview,
    Hosts,
    Detail;

    /// The tab label.
    public String label() {
        return switch (this) {
            case View.Overview -> "overview";
            case View.Hosts -> "hosts";
            case View.Detail -> "detail";
        };
    }

    /// The action string a click on this tab produces.
    public String action() {
        return "view:" + this.label();
    }

    /// The view an action names, or null when it names something else.
    public static View? fromAction(String action) {
        for (var v : View.values()) {
            if (v.action() == action) {
                return v;
            }
        }
        return null;
    }
}

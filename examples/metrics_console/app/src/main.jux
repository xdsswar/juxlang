// Jux Metrics Console -- the entry point.
//
//   jux run                          -- render one frame, preview it as text
//   jux run -- --snapshot out.ppm    -- write the frame to a file
//   jux run -- --size 1000x620       -- pick the frame size
//   jux run -- --theme paper         -- the light palette
//   jux run -- --view hosts          -- pick the view
//   jux run -- --host db-01          -- pick the selected host
//   jux run -- --click 40 120        -- click the frame, then draw it again
//
// The console itself draws into a plain pixel buffer, so this file is the only
// one that knows where the frame ends up. That is what lets the same drawing
// code be checked by a test with no display attached.

import demo.model.Simulation;
import demo.render.Canvas;
import demo.render.Console;
import demo.render.Theme;
import demo.render.View;
import jux.std.io.File;

public void main(String[] args) {
    int w = 900;
    int h = 560;
    String? out = null;
    var theme = Theme.midnight();
    String? view = null;
    String? host = null;
    int clickX = -1;
    int clickY = -1;

    int i = 0;
    while (i < args.length) {
        var a = args[i];
        if (a == "--snapshot" && i + 1 < args.length) {
            out = args[i + 1];
            i = i + 1;
        } else if (a == "--view" && i + 1 < args.length) {
            view = args[i + 1];
            i = i + 1;
        } else if (a == "--host" && i + 1 < args.length) {
            host = args[i + 1];
            i = i + 1;
        } else if (a == "--click" && i + 2 < args.length) {
            clickX = parseInt(args[i + 1], -1);
            clickY = parseInt(args[i + 2], -1);
            i = i + 2;
        } else if (a == "--theme" && i + 1 < args.length) {
            theme = args[i + 1] == "paper" ? Theme.paper() : Theme.midnight();
            i = i + 1;
        } else if (a == "--size" && i + 1 < args.length) {
            var dims = args[i + 1].split("x");
            if (dims.length == 2) {
                w = parseInt(dims[0], w);
                h = parseInt(dims[1], h);
            }
            i = i + 1;
        }
        i = i + 1;
    }

    // A fixed seed and a fixed number of steps: the same frame every run,
    // which is what lets a test assert on one.
    var sim = new Simulation(20260908);
    sim.warmUp(40);

    var console = new Console(sim.fleet(), theme);
    var canvas = new Canvas(w, h);

    if (host != null) {
        if (!console.select(host!!)) {
            print("no such host: " + host!!);
            return;
        }
    }
    if (view != null) {
        var chosen = View.fromAction("view:" + view!!);
        if (chosen == null) {
            print("no such view: " + view!!);
            return;
        }
        console.setView(chosen!!);
    }

    console.render(canvas);

    // A click needs a frame to land on: the hit regions are built by a
    // render, which is exactly how the window works too. Click, then draw
    // again to show the result.
    if (clickX >= 0 && clickY >= 0) {
        bool changed = console.click(clickX, clickY);
        // Report the whole state, not just whether something moved: a click
        // can change the view, the palette, or the selection, and a caller
        // (or a test) wants to know which.
        print("click " + clickX + "," + clickY
              + (changed ? " -> " : " -> no change; ")
              + "view " + console.view().label()
              + "  theme " + console.theme().name()
              + "  host " + (console.selected() == null ? "none" : console.selected()!!));
        console.render(canvas);
    }

    if (out != null) {
        writePpm(canvas, out!!);
        print("wrote " + w + "x" + h + " " + theme.name() + " "
              + console.view().label() + " frame to " + out!!);
        return;
    }
    preview(canvas);
}

/// Parse a decimal size, falling back rather than failing: a mistyped
/// `--size` should still draw something.
public int parseInt(String s, int fallback) {
    int value = 0;
    if (s.length() == 0) {
        return fallback;
    }
    for (int i = 0; i < s.length(); i++) {
        var ch = s.substring(i, i + 1);
        int digit = "0123456789".indexOf(ch);
        if (digit < 0) {
            return fallback;
        }
        value = value * 10 + digit;
    }
    return value;
}

/// The frame as a plain-text PPM (P3).
///
/// Verbose on purpose: no image library, no binary I/O, and any viewer or
/// one-line script reads it back. This is the path the test uses.
public void writePpm(Canvas c, String path) {
    // `+=` on a String appends in place; `sb = sb + ...` would copy the
    // whole buffer on every one of half a million pixels.
    var sb = "P3\n" + c.width() + " " + c.height() + "\n255\n";
    for (int y = 0; y < c.height(); y++) {
        for (int x = 0; x < c.width(); x++) {
            int p = c.get(x, y);
            sb += ((p >> 16) & 255) + " ";
            sb += ((p >> 8) & 255) + " ";
            sb += (p & 255) + "\n";
        }
    }
    File.writeText(path, sb);
}

/// A coarse text preview, so `jux run` with no arguments shows the frame
/// rather than nothing. Each cell is the brightest pixel in a block, which
/// keeps the panels and the bars legible at a fortieth of the size.
public void preview(Canvas c) {
    int cols = 90;
    int rows = 30;
    int cw = c.width() / cols;
    int ch = c.height() / rows;
    var ramp = " .:-=+*#%@";

    for (int ry = 0; ry < rows; ry++) {
        var line = "";
        for (int rx = 0; rx < cols; rx++) {
            int best = 0;
            for (int dy = 0; dy < ch; dy = dy + 2) {
                for (int dx = 0; dx < cw; dx = dx + 2) {
                    int p = c.get(rx * cw + dx, ry * ch + dy);
                    int lum = ((p >> 16) & 255) + ((p >> 8) & 255) * 2 + (p & 255);
                    if (lum > best) {
                        best = lum;
                    }
                }
            }
            int idx = best * 9 / 1020;
            if (idx > 9) {
                idx = 9;
            }
            line += ramp.substring(idx, idx + 1);
        }
        print(line);
    }
}

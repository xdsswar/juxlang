// A machine the console is watching, and the fleet of them.

package demo.model;

import demo.core.Series;
import demo.core.Ring;
import demo.core.Table;
import demo.core.Aggregate;

/// One named reading over time. Generic in the sample type so a host can
/// carry percentages, byte counts and latencies without three classes.

public class Host {
    private String name;
    private String region;
    private Metric<int> cpu;
    private Metric<int> memory;
    private Metric<int> latency;

    public Host(String name, String region, Aggregate<int> cpuSummary) {
        this.name = name;
        this.region = region;
        this.cpu = new Metric<int>("cpu", "%", 32, cpuSummary);
        this.memory = new Metric<int>("mem", "%", 32, cpuSummary);
        this.latency = new Metric<int>("p99", "ms", 32, cpuSummary);
    }

    public String name() { return this.name; }
    public String region() { return this.region; }
    public Metric<int> cpu() { return this.cpu; }
    public Metric<int> memory() { return this.memory; }
    public Metric<int> latency() { return this.latency; }

    public void observe(int cpuPct, int memPct, int latencyMs) {
        this.cpu.record(cpuPct);
        this.memory.record(memPct);
        this.latency.record(latencyMs);
    }

    /// The worst of the two percentage readings decides the host's level.
    public Severity severity() {
        if (this.cpu.isEmpty()) {
            return Severity.Ok;
        }
        var byCpu = Severity.forPercent(this.cpu.window().last());
        var byMem = Severity.forPercent(this.memory.window().last());
        if (byMem.atLeast(byCpu)) {
            return byMem;
        }
        return byCpu;
    }
}

// Recursion that never stops overflows the stack. The report is in Jux
// terms on Windows (GAPS.md gap 33) and on Linux and macOS (gap 38).
// `bin/jux/tests/runtime_failures.rs` runs it; the output corpus does not,
// since the report goes to stderr with no `.jux` line.

int depth(int n) {
    if (n < 0) {
        return 0;
    }
    return depth(n + 1) + 1;
}

public void main() {
    print("recursing");
    print(depth(0));
}

// One render, start to finish.
package studio;

import rust.tiny_skia.Pixmap;

/**
 * Draws a scene at a given size and reports what came out.
 *
 * Everything a render needs is created inside the call, so a render is a unit
 * of work that shares nothing: two of them run at once on separate threads,
 * and only the value they return crosses back.
 */
public class Studio {
    /** Draw at `width` x `height` and fold the result into a histogram. */
    public static Histogram analyse(int width, int height) {
        var scene = new Scene(width, height);
        return Studio.fold(scene.render());
    }

    /**
     * Fold every pixel of a finished canvas into per-channel totals.
     *
     * The buffer is tiny-skia's own: four bytes per pixel, premultiplied,
     * row-major, with no padding between rows.
     */
    public static Histogram fold(Pixmap canvas) {
        var pixels = canvas.data();
        var count = (int) (canvas.width() * canvas.height());

        long red = 0;
        long green = 0;
        long blue = 0;
        long opaque = 0;
        long transparent = 0;

        for (int i = 0; i < count; i++) {
            var at = i * 4;
            red = red + pixels[at];
            green = green + pixels[at + 1];
            blue = blue + pixels[at + 2];
            var alpha = pixels[at + 3];
            if (alpha == 255) {
                opaque = opaque + 1;
            } else if (alpha == 0) {
                transparent = transparent + 1;
            }
        }
        return new Histogram(red, green, blue, opaque, transparent);
    }
}

// Exception reporting from a program with NO `package` declaration — the shape
// most small Jux programs have.
//
// Exceptions lower to a typed panic caught by `catch_unwind`, and the entry
// point installs two things on top: a hook that keeps Rust's own panic message
// off stderr for a typed throw, and a reporter that prints an escaped exception
// Java-style. Both were attached by renaming the emitted entry point — and the
// rename did not recognise the shape a package-less program emits, so neither
// layer was installed for it. Every CAUGHT exception printed
// "thread 'main' panicked ... Box<dyn Any>" to stderr, and an UNCAUGHT one
// printed that instead of its type and message.
//
// So the point of this example is as much what it does NOT print as what it
// does: its stderr has to be empty.

public class Retry extends RuntimeException {
    public int attempt;
    public Retry(String msg, int attempt) { super(msg); this.attempt = attempt; }
}

int attempts(int failuresBefore) {
    int tries = 0;
    while (true) {
        tries = tries + 1;
        try {
            if (tries <= failuresBefore) {
                throw new Retry("not yet", tries);
            }
            return tries;
        } catch (Retry e) {
            // Caught every time around: the loop is the point, and none of
            // these may reach stderr.
            print("retry " + e.attempt);
        }
    }
}

void main() {
    print(attempts(3));

    // A throw crossing a call boundary, caught by a supertype.
    try {
        throw new Retry("outer", 9);
    } catch (RuntimeException e) {
        print("caught as supertype: " + e.getMessage());
    } finally {
        print("finally ran");
    }
}

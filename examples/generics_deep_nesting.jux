// Deeply nested generics with many parameters (ERRATA E1XX-GAP39): classes
// of four and six parameters nested five and six levels deep, function types
// and lambdas over them, generic records and payload enums, an async task
// of a nested generic, `var` through nested generic calls, the diamond,
// wildcards over nested types, aliases of nested generics, a nested generic
// class, and one type parameter carried down a hierarchy under an
// intersection bound.

import rust.std.Vec;
import rust.std.HashMap;

class Pair<K, V> { public K k; public V v; public Pair(K k, V v) { this.k = k; this.v = v; } }
class Tri<A, B, C> { public A a; public B b; public C c; public Tri(A a, B b, C c) { this.a = a; this.b = b; this.c = c; } }
class Quad<A, B, C, D> {
    public A a; public B b; public C c; public D d;
    public Quad(A a, B b, C c, D d) { this.a = a; this.b = b; this.c = c; this.d = d; }
    public D last() { return d; }
}
class Hex<A, B, C, D, E, F> {
    public A a; public B b; public C c; public D d; public E e; public F f;
    public Hex(A a, B b, C c, D d, E e, F f) { this.a = a; this.b = b; this.c = c; this.d = d; this.e = e; this.f = f; }
    public Hex<F, E, D, C, B, A> rev() { return new Hex<F, E, D, C, B, A>(f, e, d, c, b, a); }
}

record Cell<T, U>(T left, U right) {
    U rightOr(U other) { return right; }
}

enum Result2<T, E> {
    Ok(T),
    Err(E)
}

<K, V> Tri<K, Vec<V>, int> summarize(Pair<K, Vec<V>> p) { return new Tri<K, Vec<V>, int>(p.k, p.v, (int) p.v.len()); }

<A, B, C, D, E> Quad<E, D, C, Pair<A, B>> shuffle(A a, B b, C c, D d, E e) {
    return new Quad<E, D, C, Pair<A, B>>(e, d, c, new Pair<A, B>(a, b));
}

String describe(Result2<Vec<Pair<String, int>>, String> r) {
    return switch (r) {
        case Result2.Ok(var xs) -> $"ok ${xs.len()}";
        case Result2.Err(var m) -> $"err ${m}";
    };
}

async Tri<int, Vec<Pair<String, double>>, String> load(int n) {
    Vec<Pair<String, double>> v = new Vec<Pair<String, double>>();
    for (int i = 0; i < n; i++) { v.push(new Pair<String, double>("k" + i, i * 0.5)); }
    return new Tri<int, Vec<Pair<String, double>>, String>(n, v, "done");
}

async double sumLoad() {
    var t = await load(3);
    double s = 0.0;
    for (Pair<String, double> p : t.b) { s += p.v; }
    return s + t.a;
}

// ---- aliases of nested generics ---------------------------------------------

interface Named { String name(); }
interface Aged { int age(); }
abstract class Base { public int id = 1; public int ident() { return id; } }
class Person extends Base implements Named, Aged {
    String n; int a;
    Person(String n, int a) { this.n = n; this.a = a; }
    public String name() { return n; }
    public int age() { return a; }
}
class Student extends Person {
    Student(String n, int a) { super(n, a); }
    @Override public String name() { return "st:" + n; }
}

class Registry<T extends Named & Aged, K, V> {
    HashMap<K, V> byKey = new HashMap<K, V>();
    Vec<T> all = new Vec<T>();
    public void put(K k, V v) { byKey.insert(k, v); }
    public void enroll(T t) { all.push(t); }
    public int count() { return (int) byKey.len(); }
    public int ages() { int s = 0; for (T t : all) { s += t.age(); } return s; }
}

type Reg<T> = Registry<T, String, Vec<Pair<String, T>>>;
type Table<V> = HashMap<String, Vec<Pair<int, V>>>;
type Grid = Vec<Vec<Pair<int, int>>>;

// ---- one parameter down a hierarchy under an intersection bound -------------

class Roster<T extends Base & Named & Aged> {
    Vec<T> xs = new Vec<T>();
    void add(T t) { xs.push(t); }
    String names() { String s = ""; for (T x : xs) { s = s + x.name() + ","; } return s; }
}
class Squad<T extends Base & Named & Aged> extends Roster<T> {
    int total() { int s = 0; for (T x : xs) { s += x.age() + x.ident(); } return s; }
}
class StudentSquad extends Squad<Student> {
    String lead() { return xs[0].name(); }
}

// ---- wildcards over nested types --------------------------------------------

int countAll(Vec<? extends Pair<String, Vec<int>>> xs) {
    int n = 0;
    for (var p : xs) { n += (int) p.v.len(); }
    return n;
}
String firstName(Vec<? extends Person> ps) { return ps[0].name(); }
void addStudent(Vec<? super Student> sink) { sink.push(new Student("new", 18)); }

// ---- a nested generic class -------------------------------------------------

class Outer<T> {
    public T t;
    public Outer(T t) { this.t = t; }
    class Inner<U> {
        public U u;
        public Inner(U u) { this.u = u; }
        public U get() { return u; }
    }
}

public async void main() {
    // Five and six levels, four to six parameters.
    Hex<int, String, double, Vec<int>, Pair<String, Tri<int, int, Quad<int, int, int, String>>>, bool> h =
        new Hex<int, String, double, Vec<int>, Pair<String, Tri<int, int, Quad<int, int, int, String>>>, bool>(
            1, "two", 3.0, new Vec<int>(),
            new Pair<String, Tri<int, int, Quad<int, int, int, String>>>("p",
                new Tri<int, int, Quad<int, int, int, String>>(5, 6, new Quad<int, int, int, String>(7, 8, 9, "deep"))),
            true);
    print(h.e.v.c.d);
    print(h.e.v.c.last());
    print(h.e.v.c.a + h.e.v.b + h.a + h.c);
    var r = h.rev();
    print(r.a);
    print(r.b.v.c.d);
    print(r.f + 1);
    HashMap<String, Vec<Pair<int, HashMap<String, Vec<Tri<int, String, double>>>>>> world =
        new HashMap<String, Vec<Pair<int, HashMap<String, Vec<Tri<int, String, double>>>>>>();
    world.insert("w", new Vec<Pair<int, HashMap<String, Vec<Tri<int, String, double>>>>>());
    HashMap<String, Vec<Tri<int, String, double>>> inner = new HashMap<String, Vec<Tri<int, String, double>>>();
    Vec<Tri<int, String, double>> ts = new Vec<Tri<int, String, double>>();
    ts.push(new Tri<int, String, double>(1, "t", 0.5));
    inner.insert("i", ts);
    world.get("w")!!.push(new Pair<int, HashMap<String, Vec<Tri<int, String, double>>>>(9, inner));
    print(world.get("w")!![0].v.get("i")!![0].b);
    print(world.get("w")!![0].k + world.get("w")!![0].v.get("i")!![0].c);

    // Function types and lambdas over nested generics.
    (Pair<String, Vec<int>>) -> Tri<String, int, Vec<int>> f =
        (Pair<String, Vec<int>> p) -> new Tri<String, int, Vec<int>>(p.k, (int) p.v.len(), p.v);
    Vec<int> xs = new Vec<int>(); xs.push(3); xs.push(4);
    var t = f(new Pair<String, Vec<int>>("f", xs));
    print(t.a + t.b + t.c[1]);
    (int, Tri<int, int, int>) -> Pair<int, Vec<Tri<int, int, int>>> g = (int n, Tri<int, int, int> tr) -> {
        Vec<Tri<int, int, int>> out = new Vec<Tri<int, int, int>>();
        for (int i = 0; i < n; i++) { out.push(tr); }
        return new Pair<int, Vec<Tri<int, int, int>>>(n, out);
    };
    print(g(3, new Tri<int, int, int>(1, 2, 3)).v.len());

    // Generic functions over nested generics, and `var` through them.
    var s = summarize(new Pair<String, Vec<double>>("s", new Vec<double>()));
    print(s.a + s.c);
    var q = shuffle(1, "b", 2.5, 'd', true);
    print(q.a);
    print(q.d.k + q.d.v);
    var nested = summarize(new Pair<int, Vec<Pair<String, Tri<int, int, int>>>>(7, new Vec<Pair<String, Tri<int, int, int>>>()));
    nested.b.push(new Pair<String, Tri<int, int, int>>("z", new Tri<int, int, int>(1, 1, 1)));
    print(nested.b[0].v.c + nested.a);

    // Records and payload enums over nested generics.
    Cell<Vec<Pair<int, String>>, HashMap<String, int>> cell =
        new Cell<Vec<Pair<int, String>>, HashMap<String, int>>(new Vec<Pair<int, String>>(), new HashMap<String, int>());
    cell.left.push(new Pair<int, String>(1, "one"));
    print(cell.left[0].v);
    print(cell.rightOr(new HashMap<String, int>()).len());
    Vec<Pair<String, int>> ok = new Vec<Pair<String, int>>();
    ok.push(new Pair<String, int>("a", 1));
    print(describe(Result2.Ok(ok)));
    print(describe(Result2.Err("bad")));

    // The diamond, and an async task of a nested generic.
    Pair<String, Vec<Tri<int, int, int>>> dp = new Pair<>("dia", new Vec<>());
    dp.v.push(new Tri<>(4, 5, 6));
    print(dp.v[0].b);
    print(await sumLoad());

    // Aliases.
    Reg<Person> reg = new Reg<Person>();
    Vec<Pair<String, Person>> ps = new Vec<Pair<String, Person>>();
    ps.push(new Pair<String, Person>("a", new Person("ann", 30)));
    reg.put("g", ps);
    reg.enroll(new Person("bob", 5));
    print(reg.count());
    print(reg.ages());
    print(reg.byKey.get("g")!![0].v.name());
    Table<String> tb = new Table<String>();
    Vec<Pair<int, String>> row = new Vec<Pair<int, String>>();
    row.push(new Pair<int, String>(1, "x"));
    tb.insert("r", row);
    print(tb.get("r")!![0].v);
    Grid grid = new Grid();
    grid.push(new Vec<Pair<int, int>>());
    grid[0].push(new Pair<int, int>(2, 3));
    print(grid[0][0].k * grid[0][0].v);

    // One parameter down a bounded hierarchy.
    Squad<Person> sq = new Squad<Person>();
    sq.add(new Person("c", 40));
    sq.add(new Student("d", 20));
    print(sq.total());
    print(sq.names());
    StudentSquad ss = new StudentSquad();
    ss.add(new Student("e", 19));
    print(ss.lead());
    print(ss.total());
    Roster<Person> asRoster = sq;
    print(asRoster.names());

    // Wildcards.
    Vec<Pair<String, Vec<int>>> pv = new Vec<Pair<String, Vec<int>>>();
    Vec<int> nums = new Vec<int>(); nums.push(1); nums.push(2);
    pv.push(new Pair<String, Vec<int>>("n", nums));
    print(countAll(pv));
    Vec<Student> sts = new Vec<Student>();
    sts.push(new Student("f", 21));
    print(firstName(sts));
    Vec<Person> sink = new Vec<Person>();
    addStudent(sink);
    print(sink[0].name());

    // A nested generic class.
    Outer<int> o = new Outer<int>(4);
    Outer.Inner<String> in = new Outer.Inner<String>("inner");
    print(in.get() + o.t);
}

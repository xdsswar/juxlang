// Methods Vec gets from `[T]` through Deref — all discovered from the scan.
import rust.std.*;

public void main() {
    var v = new Vec<int>();
    v.push(10); v.push(20); v.push(30);

    print($"first=${v.first()!!} last=${v.last()!!}\n");
    print($"contains20=${v.contains(20)} contains99=${v.contains(99)}\n");
    print($"empty=${v.is_empty()} len=${v.len()}\n");
    v.reverse();
    print($"reversedFirst=${v.first()!!}\n");

    var words = new Vec<String>();
    words.push("beta");
    words.push("alpha");
    bool hasAlpha = words.contains("alpha");
    print($"hasAlpha=${hasAlpha}\n");

    // Ordering and search, also from the slice surface. Rust's stable `sort`
    // is absent from the rustdoc JSON the stub is generated from, so
    // `sort_unstable` is the discoverable one -- and it is the exact Rust
    // name, which is the rule for the std surface.
    var nums = new Vec<int>();
    nums.push(30); nums.push(10); nums.push(20);
    nums.sort_unstable();
    print($"sorted=${nums.first()!!},${nums.last()!!}\n");
    int at = nums.binary_search(20);
    print($"binarySearch20=${at}\n");
    var slot = nums.get(0);
    print($"get0=${slot!!}\n");
}

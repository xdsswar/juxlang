// What a `Worker.spawn` closure can take to another thread, and what it gets
// (JUX-ASYNC-ADDENDUM §18.2, ERRATA E27, E1XX-SWEEPA2).
//
// A worker shares what it captures, as a Java thread does. A collection or an
// array is the caller's own, behind a thread-safe handle, so a change the
// worker makes is seen by the caller once the task is awaited; a copy is made
// only when the program asks for one (`clone()`). A class object is shared
// the same way, upgraded to an atomic handle. A method's closure that reads a
// field of its own class captures `this`.

int sumRange(int[] data, int from, int to) {
    int total = 0;
    for (int i = from; i < to; i++) {
        total += data[i];
    }
    return total;
}

// The §18.2 example: two workers over halves of one array parameter.
public async int parallelSum(int[] data) {
    var mid = data.length / 2;
    var left = Worker.spawn(() -> sumRange(data, 0, mid));
    var right = Worker.spawn(() -> sumRange(data, mid, data.length));
    return await left + await right;
}

class Job {
    public int done = 0;
}

class Tally {
    public int base = 100;

    // `base` is `this.base`: the closure captures the object.
    public async int plus(int n) {
        var t = Worker.spawn(() -> base + n);
        return await t;
    }
}

public async void main() {
    int[] data = new int[10];
    for (int i = 0; i < 10; i++) {
        data[i] = i + 1;
    }
    print(await parallelSum(data));

    // A captured collection is the caller's own: what the worker pushes, the
    // caller sees. A copy is one the program asks for.
    var names = new Vec<String>();
    names.push("ann");
    var grown = Worker.spawn(() -> {
        names.push("bob");
        var mine = names.clone();
        mine.push("cy");
        return mine.len();
    });
    print(await grown);
    print(names.len());

    var ages = new HashMap<String, int>();
    ages.insert("ann", 31);
    var count = Worker.spawn(() -> ages.len());
    print(await count);

    // Class objects are shared, and so is the collection holding them.
    var jobs = new Vec<Job>();
    jobs.push(new Job());
    jobs.push(new Job());
    var worked = Worker.spawn(() -> {
        for (var j : jobs) {
            j.done = 1;
        }
        return jobs.len();
    });
    print(await worked);
    int finished = 0;
    for (var j : jobs) {
        finished += j.done;
    }
    print(finished);

    print(await new Tally().plus(5));
}

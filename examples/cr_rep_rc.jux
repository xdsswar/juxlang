// Class representation, the `Rc` tier (JUX-CLASS-REPRESENTATION-ADDENDUM
// §CR.4.1, ERRATA E1XX-PHASE8).
//
// A class whose objects are never written after construction is shared
// through a plain `Rc`: no cell, no borrow flag, nothing that can be "in use".
// `Point` and `Palette` are such classes. `Counter` is written by `bump`, so
// it keeps its cell. The representation is invisible: every class still
// behaves as a Java reference. An alias is the same object, `===` compares
// identity, and a write through one name is seen through every other.

class Point {
    private int x;
    private int y;

    public Point(int x, int y) {
        this.x = x;
        this.y = y;
    }

    public int getX() { return x; }
    public int getY() { return y; }

    public Point plus(Point other) {
        return new Point(x + other.x, y + other.y);
    }

    public String operator string() { return $"(${x}, ${y})"; }
}

class Palette {
    private String name;
    private String[] colors;

    public Palette(String name, String[] colors) {
        this.name = name;
        this.colors = colors;
    }

    public String describe() {
        return $"${name}: ${colors.length} colors, first ${colors[0]}";
    }
}

class Counter {
    private int count = 0;
    public void bump() { count += 1; }
    public int get() { return count; }
}

public void main() {
    // An immutable object, shared by two names and a list.
    var origin = new Point(0, 0);
    var alias = origin;
    var points = new Vec<Point>();
    points.push(origin);
    points.push(new Point(3, 4));
    print(alias === origin);
    print(points[0] === origin);
    print(new Point(0, 0) === origin);
    print(origin.plus(points[1]));

    // Its fields are read through the refcount alone.
    var sum = 0;
    for (var p : points) {
        sum += p.getX() + p.getY();
    }
    print(sum);

    // An immutable object holding an array: the array is its own shared
    // handle, so writing an element does not write the palette.
    var colors = new String[]{"red", "green"};
    var warm = new Palette("warm", colors);
    colors[0] = "orange";
    var shown = warm;
    print(shown.describe());

    // A mutable object keeps its cell, and a write through one alias is seen
    // through the other.
    var c = new Counter();
    var same = c;
    same.bump();
    c.bump();
    print(c.get());
    print(same === c);
}

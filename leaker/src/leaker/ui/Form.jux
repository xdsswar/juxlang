// Label-and-field rows, laid out top to bottom inside a rectangle.
package leaker.ui;

import rust.eframe.Ui;
import rust.eframe.Rect;

public class Form {
    private float x;
    private float y;
    private float width;
    private float labelWidth;

    public Form(Rect area, float labelWidth) {
        this.x = area.min.x;
        this.y = area.min.y;
        this.width = area.width();
        this.labelWidth = labelWidth;
    }

    public float cursorY() {
        return y;
    }

    public void skip(float dy) {
        y += dy;
    }

    /** A labelled one-line field; returns its text after this frame's edits. */
    public String field(Ui ui, String label, String value) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        var l = Gui.row(ui, Gui.rect(x, y, labelWidth, Palette.FIELD_HEIGHT));
        Gui.text(l, label, Palette.muted(), 13.0f);
        float fw = width - labelWidth;
        var f = Gui.row(ui, Gui.rect(x + labelWidth, y, fw, Palette.FIELD_HEIGHT));
        var result = Gui.textFieldWidth(f, value, fw - 4.0f);
        y += Palette.FIELD_HEIGHT + 8.0f;
        return result;
    }

    /** A field with a validation message under it when `error` is not empty. */
    public String checkedField(Ui ui, String label, String value, String error) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        var result = field(ui, label, value);
        if (error.length() > 0) {
            var e = Gui.row(ui, Gui.rect(x + labelWidth, y - 6.0f, width - labelWidth, 16.0f));
            Gui.text(e, error, Palette.danger(), 12.0f);
            y += 12.0f;
        }
        return result;
    }

    /** A labelled multi-line field, `height` tall. */
    public String area(Ui ui, String label, String value, float height) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        var l = Gui.row(ui, Gui.rect(x, y, labelWidth, Palette.FIELD_HEIGHT));
        Gui.text(l, label, Palette.muted(), 13.0f);
        var f = Gui.area(ui, Gui.rect(x + labelWidth, y, width - labelWidth, height));
        var result = Gui.textArea(f, value);
        y += height + 8.0f;
        return result;
    }

    /** A labelled read-only value. */
    public void value(Ui ui, String label, String text) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        var l = Gui.row(ui, Gui.rect(x, y, labelWidth, Palette.FIELD_HEIGHT));
        Gui.text(l, label, Palette.muted(), 13.0f);
        var f = Gui.row(ui, Gui.rect(x + labelWidth, y, width - labelWidth, Palette.FIELD_HEIGHT));
        Gui.strong(f, text, Palette.ink(), 13.5f);
        y += Palette.FIELD_HEIGHT + 8.0f;
    }

    /** A row for buttons, returned so the caller can put what it likes in it. */
    public Ui buttons(Ui ui) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        var r = Gui.row(ui, Gui.rect(x + labelWidth, y + 4.0f, width - labelWidth, Palette.FIELD_HEIGHT + 4.0f));
        y += Palette.FIELD_HEIGHT + 16.0f;
        return r;
    }
}

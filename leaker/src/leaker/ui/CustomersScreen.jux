// Customers: the list, and a form beside it (or below it in a narrow window)
// to add, edit and delete them.
package leaker.ui;

import rust.eframe.Ui;
import rust.eframe.Panel;
import rust.eframe.Id;
import rust.eframe.Grid;
import rust.eframe.ScrollArea;
import rust.eframe.RichText;
import rust.eframe.TextEdit;
import rust.eframe.Button;
import rust.eframe.Color32;
import rust.eframe.Vec2;
import leaker.model.Customer;

public class CustomersScreen {
    private Session session;
    private int selectedId = 0;

    // The form edits these, not the customer, so Clear means clear.
    private String name = "";
    private String email = "";
    private String address = "";
    private String taxId = "";
    private String nameError = "";
    private String emailError = "";

    public CustomersScreen(Session session) {
        this.session = session;
    }

    public void show(Ui ui) {
        ui.horizontal((row) -> {
            row.heading("Customers");
            row.add_space(12.0f);
            row.weak($"${session.store.customers.len()} on file");
            row.add_space(12.0f);
            if (row.button("+ New customer").clicked()) {
                startNew();
            }
        });
        ui.add_space(6.0f);

        // Wide windows put the form beside the list, narrow ones below it.
        var form = ui.available_width() >= 900.0f
            ? Panel.right(new Id("customer-form")).resizable(true).default_size(380.0f).min_size(340.0f)
            : Panel.bottom(new Id("customer-form-below")).resizable(true).default_size(330.0f);
        form.show(ui, (panel) -> showForm(panel));

        ScrollArea.vertical().auto_shrink(false).show(ui, (scroll) -> {
            new Grid("customers").striped(true).num_columns(4).min_col_width(60.0f).show(scroll, (grid) -> {
                grid.strong("#");
                grid.strong("Name");
                grid.strong("Email");
                grid.strong("Tax ID");
                grid.end_row();
                for (var c : session.store.customers) {
                    grid.label($"${c.id}");
                    if (grid.selectable_label(c.id == selectedId, c.name).clicked()) {
                        select(c);
                    }
                    grid.label(c.email);
                    grid.label(c.taxId);
                    grid.end_row();
                }
            });
        });
    }

    private void showForm(Ui ui) {
        ui.add_space(8.0f);
        ui.label(new RichText(selectedId == 0 ? "New customer" : $"Edit customer #${selectedId}").strong().size(15.0f));
        ui.add_space(8.0f);
        new Grid("customer-fields").num_columns(2).spacing(new Vec2(12.0f, 8.0f)).show(ui, (grid) -> {
            grid.label("Name");
            grid.vertical((cell) -> {
                cell.add(TextEdit.singleline(name).desired_width(240.0f));
                if (nameError.length() > 0) {
                    cell.colored_label(Palette.DANGER, nameError);
                }
            });
            grid.end_row();

            grid.label("Email");
            grid.vertical((cell) -> {
                cell.add(TextEdit.singleline(email).desired_width(240.0f));
                if (emailError.length() > 0) {
                    cell.colored_label(Palette.DANGER, emailError);
                }
            });
            grid.end_row();

            grid.label("Address");
            grid.vertical((cell) -> {
                cell.add(TextEdit.singleline(address).desired_width(240.0f));
                cell.weak("Separate address lines with a comma.");
            });
            grid.end_row();

            grid.label("Tax ID");
            grid.add(TextEdit.singleline(taxId).desired_width(240.0f));
            grid.end_row();
        });

        ui.add_space(12.0f);
        ui.horizontal((row) -> {
            var save = new Button(new RichText(selectedId == 0 ? "Add customer" : "Save changes").color(Color32.WHITE)).fill(Palette.ACCENT);
            if (row.add(save).clicked()) {
                save();
            }
            if (row.button("Clear").clicked()) {
                startNew();
            }
            if (selectedId != 0) {
                row.add_space(24.0f);
                if (row.add(new Button(new RichText("Delete").color(Color32.WHITE)).fill(Palette.DANGER)).clicked()) {
                    delete();
                }
            }
        });
    }

    private void startNew() {
        selectedId = 0;
        name = "";
        email = "";
        address = "";
        taxId = "";
        nameError = "";
        emailError = "";
    }

    private void select(Customer c) {
        selectedId = c.id;
        name = c.name;
        email = c.email;
        address = c.address;
        taxId = c.taxId;
        nameError = "";
        emailError = "";
    }

    private bool validate() {
        nameError = name.trim().length() == 0 ? "A name is required." : "";
        String e = email.trim();
        emailError = e.length() > 0 && (!e.contains("@") || !e.contains(".")) ? "That does not look like an email address." : "";
        return nameError.length() == 0 && emailError.length() == 0;
    }

    private void save() {
        if (!validate()) {
            session.error("Please fix the highlighted fields.");
            return;
        }
        if (selectedId == 0) {
            var c = session.store.addCustomer(name.trim(), email.trim(), address.trim(), taxId.trim());
            select(c);
            session.info($"Added customer ${c.name}.");
            return;
        }
        var existing = session.store.findCustomer(selectedId);
        if (existing == null) {
            session.error("That customer no longer exists.");
            startNew();
            return;
        }
        var c = existing!!;
        c.name = name.trim();
        c.email = email.trim();
        c.address = address.trim();
        c.taxId = taxId.trim();
        session.info($"Saved ${c.name}.");
    }

    private void delete() {
        var existing = session.store.findCustomer(selectedId);
        if (existing == null) {
            startNew();
            return;
        }
        String who = existing!!.name;
        if (session.store.deleteCustomer(selectedId)) {
            session.info($"Deleted customer ${who}.");
            startNew();
        } else {
            session.error($"${who} still has invoices; delete those first.");
        }
    }
}

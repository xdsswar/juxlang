// The widget toolkit the screens are written against.
//
// Every method here wraps one egui call in the shape Jux can actually make
// it. Most of them exist because the natural spelling does not compile; each
// such place names its LEAKS.md finding, so the reason travels with the
// workaround.
package leaker.ui;

import rust.eframe.Ui;
import rust.eframe.UiBuilder;
import rust.eframe.WidgetText;
import rust.eframe.RichText;
import rust.eframe.Button;
import rust.eframe.Rect;
import rust.eframe.Pos2;
import rust.eframe.Vec2;
import rust.eframe.Layout;
import rust.eframe.Align;
import rust.eframe.Sense;
import rust.eframe.CornerRadius;
import rust.eframe.ComboBox;
import rust.eframe.Stroke;
import rust.eframe.StrokeKind;
import rust.egui.Color32;
import rust.eframe.Style;
import rust.eframe.Visuals;

public class Gui {

    // ---- geometry ------------------------------------------------------

    public static Rect rect(float x, float y, float w, float h) {
        return Rect.from_min_size(new Pos2(x, y), new Vec2(w, h));
    }

    // ---- sub-areas -----------------------------------------------------
    //
    // egui's containers (panels, scroll areas, grids, horizontal rows) all
    // take a closure over `&mut Ui`, and a Jux lambda in that slot receives a
    // CLONE of its argument (LEAKS.md L1), which for `Ui` does not even
    // compile. So the app lays itself out: every region is a child `Ui`
    // pinned to a rectangle the screen computed.

    /** A top-down child area filling `r`. */
    public static Ui area(Ui ui, Rect bounds) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        return ui.new_child(new UiBuilder().max_rect(bounds).layout(Layout.top_down(Align.Min)));
    }

    /** A left-to-right row filling `r`, contents vertically centered. */
    public static Ui row(Ui ui, Rect bounds) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        return ui.new_child(new UiBuilder().max_rect(bounds).layout(Layout.left_to_right(Align.Center)));
    }

    /** A right-to-left row: what it holds hugs the right edge (numbers). */
    public static Ui rowRight(Ui ui, Rect bounds) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        return ui.new_child(new UiBuilder().max_rect(bounds).layout(Layout.right_to_left(Align.Center)));
    }

    // ---- painting ------------------------------------------------------

    public static void fill(Ui ui, Rect bounds, Color32 color) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        ui.painter().rect_filled(bounds, CornerRadius.same((ubyte) 0), color);
    }

    public static void card(Ui ui, Rect bounds) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        ui.painter().rect(bounds, CornerRadius.same((ubyte) 6), Palette.card(), new Stroke(1.0f, Palette.border()), StrokeKind.Inside);
    }

    public static void hline(Ui ui, float x1, float x2, float y, Color32 color) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        ui.painter().rect_filled(rect(x1, y, x2 - x1, 1.0f), CornerRadius.same((ubyte) 0), color);
    }

    // ---- text ----------------------------------------------------------
    //
    // `ui.label("...")` does not type-check: the parameter is Rust's
    // `impl Into<WidgetText>`, surfaced as the concrete `WidgetText`, and a
    // Jux String is not one (L2). The enum variant is.

    public static void label(Ui ui, String text) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        ui.label(WidgetText.Text(text));
    }

    public static void text(Ui ui, String text, Color32 color, float size) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        ui.colored_label(color, new RichText(text).size(size));
    }

    public static void strong(Ui ui, String text, Color32 color, float size) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        ui.colored_label(color, new RichText(text).size(size).strong());
    }

    public static void heading(Ui ui, String text) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        ui.colored_label(Palette.ink(), new RichText(text).size(20.0f).strong());
    }

    public static void muted(Ui ui, String text) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        ui.colored_label(Palette.muted(), new RichText(text).size(12.5f));
    }

    // ---- input ---------------------------------------------------------
    //
    // The next methods all end by handing `ui` to a foreign `&mut Ui`
    // parameter. Straight from a parameter that emits `&mut ui` on a
    // non-`mut` binding (L9); rebinding to a local first compiles. The
    // `add_space(0)` makes the parameter a mutable borrow rather than a move.

    /** A push button. True on the frame it was clicked. */
    public static bool button(Ui ui, String text) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        var u = ui;
        // `ui.button(...)` and `ui.add(new Button(...))` both lower to a
        // `Box<dyn crate::rust::...>` path that does not exist (L3).
        var b = Button.opt_image_and_text(null, WidgetText.Text(text));
        return b.atom_ui(u).response.clicked();
    }

    /** A filled, colored button for the main action of a screen. */
    public static bool primaryButton(Ui ui, String text) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        var u = ui;
        var b = Button.opt_image_and_text(null, WidgetText.Text(text).color(Palette.white())).fill(Palette.accent());
        return b.atom_ui(u).response.clicked();
    }

    public static bool dangerButton(Ui ui, String text) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        var u = ui;
        var b = Button.opt_image_and_text(null, WidgetText.Text(text).color(Palette.white())).fill(Palette.danger());
        return b.atom_ui(u).response.clicked();
    }

    /**
     * A one-line text field. Returns the (possibly edited) text.
     *
     * Passing a field straight in, `ui.text_edit_singleline(form.name)`,
     * copies the field into a temporary and lends THAT (L8): it does not
     * compile, and if it did the typing would be lost. A local does work.
     */
    public static String textField(Ui ui, String value) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        String v = value;
        ui.text_edit_singleline(v);
        return v;
    }

    /**
     * A text field exactly `width` wide. `ui.spacing_mut().text_edit_width = w`
     * compiles and does nothing, because the `&mut` the accessor returns is
     * cloned on the way out (L10). Copying `ui.style()` does not work either:
     * it is an `Arc<Style>` in Rust, the stub says `Style`, and assigning a
     * field of it is rustc E0594 (L16). A fresh default style does work, at
     * the price of restating the visuals.
     */
    public static String textFieldWidth(Ui ui, String value, float width) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        var style = new Style();
        style.visuals = Palette.visuals();
        style.spacing.text_edit_width = width;
        ui.set_style(style);
        String v = value;
        ui.text_edit_singleline(v);
        return v;
    }

    public static String textArea(Ui ui, String value) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        String v = value;
        ui.text_edit_multiline(v);
        return v;
    }

    /**
     * A drop-down over `items`; returns the chosen index. `label` must be
     * unique on screen: it is also the widget's id, since the id-taking
     * constructor wants an `impl Hash` value that Jux cannot supply (L4).
     */
    public static int combo(Ui ui, String label, Vec<String> items, int selected, float width) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        var u = ui;
        uint sel = selected < 0 ? (uint) 0 : (uint) selected;
        // The item count is read before the call: using `items` both as an
        // argument and inside the lambda in one call fails to borrow (L12).
        uint count = (uint) items.len();
        ComboBox.from_label(WidgetText.Text(label)).width(width).show_index(u, sel, count, (i) -> WidgetText.Text(items[i]));
        return (int) sel;
    }

    // ---- interaction ---------------------------------------------------

    /** Whether the pointer is inside `r` and the primary button was clicked there. */
    public static bool clickedIn(Ui ui, Rect bounds) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        var id = ui.next_auto_id();
        ui.skip_ahead_auto_ids((uint) 1);
        return ui.interact(bounds, id, Sense.click()).clicked();
    }

    public static bool hovered(Ui ui, Rect bounds) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        return ui.rect_contains_pointer(bounds);
    }
}

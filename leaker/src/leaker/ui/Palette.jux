// Colors, in one place.
package leaker.ui;

import rust.eframe.Color32;
import rust.eframe.Visuals;
import rust.eframe.Stroke;

public class Palette {
    public static final Color32 PAGE_BG = Color32.from_rgb(246, 248, 251);
    public static final Color32 BORDER = Color32.from_rgb(223, 228, 236);
    public static final Color32 INK = Color32.from_rgb(30, 41, 59);
    public static final Color32 MUTED = Color32.from_rgb(100, 116, 139);
    public static final Color32 ACCENT = Color32.from_rgb(37, 99, 235);
    public static final Color32 DANGER = Color32.from_rgb(220, 38, 38);
    public static final Color32 SUCCESS = Color32.from_rgb(22, 163, 74);
    public static final Color32 WARNING = Color32.from_rgb(217, 119, 6);

    /** The color an invoice status is shown in. */
    public static Color32 status(String label) {
        return switch (label) {
            case "Paid" -> SUCCESS;
            case "Overdue" -> DANGER;
            case "Draft" -> WARNING;
            default -> ACCENT;
        };
    }

    /** egui's light theme, with inputs that stand out on a white panel. */
    public static Visuals visuals() {
        var v = Visuals.light();
        v.panel_fill = PAGE_BG;
        v.text_edit_bg_color = Color32.from_rgb(250, 251, 253);
        v.widgets.inactive.bg_stroke = new Stroke(1.0f, Color32.from_rgb(203, 213, 225));
        v.widgets.inactive.weak_bg_fill = Color32.from_rgb(241, 245, 249);
        v.widgets.hovered.bg_stroke = new Stroke(1.0f, ACCENT);
        v.selection.bg_fill = Color32.from_rgb(219, 234, 254);
        v.selection.stroke = new Stroke(1.0f, ACCENT);
        return v;
    }
}

// A striped, scrollable table with a header, weighted columns and row
// selection: what `egui::Grid` or `egui_extras::TableBuilder` would give,
// had their closures been callable from Jux (L1).
package leaker.ui;

import rust.eframe.Ui;
import rust.eframe.Rect;
import rust.egui.Color32;

public class Table {
    private Vec<String> headers = new Vec<String>();
    private Vec<float> weights = new Vec<float>();
    private Vec<bool> rightAligned = new Vec<bool>();
    private ScrollPane scroll = new ScrollPane();
    /** Column whose text is colored as an invoice status, or -1. */
    public int statusColumn = -1;

    public Table column(String header, float weight, bool alignRight) {
        headers.push(header);
        weights.push(weight);
        rightAligned.push(alignRight);
        return this;
    }

    /**
     * Draws the table into `area`. Returns the index of the row clicked this
     * frame, or -1.
     */
    public int show(Ui ui, Rect area, Vec<Vec<String>> rows, int selected) {
        ui.skip_ahead_auto_ids((uint) 0);  // see Gui: makes `ui` a borrow (L9)
        Gui.card(ui, area);
        float total = 0.0f;
        for (var w : weights) {
            total += w;
        }
        float x0 = area.min.x + 1.0f;
        float width = area.width() - 12.0f;
        float y0 = area.min.y + 1.0f;

        // Header.
        var head = Gui.rect(x0, y0, area.width() - 2.0f, Palette.ROW_HEIGHT);
        Gui.fill(ui, head, Palette.headerBg());
        float cx = x0;
        int ci = 0;
        for (var h : headers) {
            float cw = width * weights[ci] / total;
            var cell = Gui.rect(cx + 8.0f, y0, cw - 16.0f, Palette.ROW_HEIGHT);
            var c = rightAligned[ci] ? Gui.rowRight(ui, cell) : Gui.row(ui, cell);
            Gui.strong(c, h, Palette.muted(), 12.5f);
            cx += cw;
            ci++;
        }
        Gui.hline(ui, area.min.x, area.max.x, y0 + Palette.ROW_HEIGHT, Palette.border());

        // Body, scrolled.
        var view = Gui.rect(area.min.x + 1.0f, y0 + Palette.ROW_HEIGHT + 1.0f, area.width() - 2.0f, area.height() - Palette.ROW_HEIGHT - 3.0f);
        float contentH = (float) rows.len() * Palette.ROW_HEIGHT;
        var sp = scroll;
        var body = sp.begin(ui, view, contentH);
        var origin = body.max_rect().min;
        int clicked = -1;
        int ri = 0;
        for (var r : rows) {
            float ry = origin.y + (float) ri * Palette.ROW_HEIGHT;
            var rowRect = Gui.rect(x0, ry, area.width() - 12.0f, Palette.ROW_HEIGHT);
            bool visible = ry + Palette.ROW_HEIGHT >= view.min.y && ry <= view.max.y;
            if (visible) {
                if (ri == selected) {
                    Gui.fill(body, rowRect, Palette.rowSelected());
                } else if (Gui.hovered(body, rowRect) && Gui.hovered(ui, view)) {
                    Gui.fill(body, rowRect, Palette.rowHover());
                } else if (ri % 2 == 1) {
                    Gui.fill(body, rowRect, Palette.rgb(250, 251, 253));
                }
                if (Gui.clickedIn(body, rowRect)) {
                    clicked = ri;
                }
                float rx = x0;
                int k = 0;
                for (var text : r) {
                    float cw = width * weights[k] / total;
                    var cell = Gui.rect(rx + 8.0f, ry, cw - 16.0f, Palette.ROW_HEIGHT);
                    var c = rightAligned[k] ? Gui.rowRight(body, cell) : Gui.row(body, cell);
                    // `statusColor(text)` would move the String out from under the next
                    // line (L15), so it gets its own copy.
                    var color = k == statusColumn ? statusColor($"${text}") : Palette.ink();
                    Gui.text(c, text, color, 13.5f);
                    rx += cw;
                    k++;
                }
            }
            ri++;
        }
        if (rows.len() == 0) {
            var c = Gui.row(body, Gui.rect(x0 + 8.0f, origin.y, width, Palette.ROW_HEIGHT));
            Gui.muted(c, "Nothing here yet.");
        }
        return clicked;
    }

    public static Color32 statusColor(String status) {
        if (status == "Paid") {
            return Palette.success();
        }
        if (status == "Sent") {
            return Palette.accent();
        }
        if (status == "Overdue") {
            return Palette.danger();
        }
        return Palette.warning();
    }
}

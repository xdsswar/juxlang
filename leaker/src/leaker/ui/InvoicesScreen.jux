// Invoices: the list, and the editor one of them opens into.
package leaker.ui;

import rust.eframe.Ui;
import rust.eframe.Grid;
import rust.eframe.ScrollArea;
import rust.eframe.Button;
import rust.eframe.RichText;
import rust.eframe.Color32;

public class InvoicesScreen {
    private Session session;
    private InvoiceFilter filter = InvoiceFilter.All;
    private InvoiceEditor editor;
    private bool editing = false;

    public InvoicesScreen(Session session) {
        this.session = session;
        this.editor = new InvoiceEditor(session);
    }

    /** Opens the editor on an invoice, by number. */
    public void open(String number) {
        var inv = session.store.findInvoice(number);
        if (inv != null) {
            editor.load(inv!!);
            editing = true;
        }
    }

    public void closeEditor() {
        editing = false;
    }

    public void show(Ui ui) {
        if (editing) {
            editing = editor.show(ui);
            return;
        }

        ui.horizontal((row) -> {
            row.heading("Invoices");
            row.add_space(12.0f);
            if (row.add(new Button(new RichText("+ New invoice").color(Color32.WHITE)).fill(Palette.ACCENT)).clicked()) {
                createInvoice();
            }
        });
        ui.add_space(6.0f);
        ui.horizontal((row) -> {
            for (var f : InvoiceFilter.values()) {
                row.selectable_value(filter, f, f.label());
            }
            row.add_space(16.0f);
            row.weak("Click a number to open the invoice.");
        });
        ui.add_space(6.0f);

        ScrollArea.vertical().auto_shrink(false).show(ui, (scroll) -> {
            new Grid("invoices").striped(true).num_columns(6).min_col_width(80.0f).show(scroll, (grid) -> {
                grid.strong("Number");
                grid.strong("Customer");
                grid.strong("Issued");
                grid.strong("Due");
                grid.strong("Status");
                grid.strong("Total");
                grid.end_row();
                for (var inv : session.store.invoices) {
                    if (!filter.matches(inv, session.today)) {
                        continue;
                    }
                    if (grid.link(inv.number).clicked()) {
                        editor.load(inv);
                        editing = true;
                    }
                    grid.label(inv.customer.name);
                    grid.label(inv.issueDate.iso());
                    grid.label(inv.dueDate.iso());
                    String status = inv.isOverdue(session.today) ? "Overdue" : inv.status.label();
                    grid.colored_label(Palette.status(status), status);
                    Cells.amount(grid, 100.0f, new RichText(inv.totals().total.display()));
                    grid.end_row();
                }
            });
        });
    }

    private void createInvoice() {
        if (session.store.customers.len() == 0) {
            session.error("Add a customer first: an invoice needs someone to bill.");
            return;
        }
        var inv = session.store.createInvoice(session.store.customers[0], session.today);
        editor.load(inv);
        editing = true;
        session.info($"Created ${inv.number} as a draft. Pick the customer and add lines.");
    }
}

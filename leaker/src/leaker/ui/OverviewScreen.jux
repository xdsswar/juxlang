// Overview: the numbers that matter, then the invoices that need attention.
package leaker.ui;

import rust.eframe.Ui;
import rust.eframe.Grid;
import rust.eframe.ScrollArea;
import rust.eframe.RichText;
import rust.eframe.Color32;
import leaker.model.Money;
import leaker.model.InvoiceStatus;

public class OverviewScreen {
    private Session session;

    public OverviewScreen(Session session) {
        this.session = session;
    }

    /** Draws the overview. Returns the number of an invoice the user clicked, or null. */
    public String? show(Ui ui) {
        ui.horizontal((row) -> {
            row.heading("Overview");
            row.add_space(12.0f);
            row.weak($"as of ${session.today}");
        });
        ui.add_space(8.0f);

        var draft = Money.zero();
        var sent = Money.zero();
        var paid = Money.zero();
        var overdue = Money.zero();
        int overdueCount = 0;
        for (var inv : session.store.invoices) {
            var total = inv.totals().total;
            switch (inv.status) {
                case InvoiceStatus.Draft -> draft = draft + total;
                case InvoiceStatus.Sent -> sent = sent + total;
                case InvoiceStatus.Paid -> paid = paid + total;
            }
            if (inv.isOverdue(session.today)) {
                overdue = overdue + total;
                overdueCount++;
            }
        }

        // Four tiles in a row, or two rows of two when the window is narrow.
        int perRow = ui.available_width() >= 820.0f ? 4 : 2;
        float spacing = ui.spacing().item_spacing.x;
        float tileWidth = (ui.available_width() - spacing * (float) (perRow - 1)) / (float) perRow - 14.0f;
        ui.horizontal_wrapped((row) -> {
            tile(row, tileWidth, "Awaiting payment", sent, Palette.ACCENT);
            tile(row, tileWidth, $"Overdue (${overdueCount})", overdue, Palette.DANGER);
            tile(row, tileWidth, "Drafts", draft, Palette.WARNING);
            tile(row, tileWidth, "Collected", paid, Palette.SUCCESS);
        });

        ui.add_space(12.0f);
        ui.weak($"${session.store.customers.len()} customers, ${session.store.products.len()} products, ${session.store.invoices.len()} invoices");
        ui.add_space(8.0f);
        ui.label(new RichText("Open invoices").strong().size(15.0f));
        ui.add_space(4.0f);

        String? opened = null;
        ScrollArea.vertical().auto_shrink(false).show(ui, (scroll) -> {
            new Grid("open-invoices").striped(true).num_columns(5).min_col_width(90.0f).show(scroll, (grid) -> {
                grid.strong("Number");
                grid.strong("Customer");
                grid.strong("Due");
                grid.strong("Status");
                grid.strong("Total");
                grid.end_row();
                for (var inv : session.store.invoices) {
                    if (inv.status == InvoiceStatus.Paid) {
                        continue;
                    }
                    if (grid.link(inv.number).on_hover_text("Open this invoice").clicked()) {
                        opened = inv.number;
                    }
                    grid.label(inv.customer.name);
                    grid.label(inv.dueDate.iso());
                    String status = inv.isOverdue(session.today) ? "Overdue" : inv.status.label();
                    grid.colored_label(Palette.status(status), status);
                    Cells.amount(grid, 100.0f, new RichText(inv.totals().total.display()));
                    grid.end_row();
                }
            });
        });
        return opened;
    }

    private void tile(Ui ui, float width, String label, Money amount, Color32 color) {
        ui.group((box) -> {
            box.set_width(width);
            box.vertical((column) -> {
                column.label(new RichText(label).color(Palette.MUTED));
                column.label(new RichText(amount.display()).size(22.0f).strong().color(color));
            });
        });
    }
}

// Creating and editing one invoice: customer, dates, lines, live totals,
// status, and the PDF.
package leaker.ui;

import rust.eframe.Ui;
import rust.eframe.Panel;
import rust.eframe.Id;
import rust.eframe.Grid;
import rust.eframe.ScrollArea;
import rust.eframe.ComboBox;
import rust.eframe.TextEdit;
import rust.eframe.DragValue;
import rust.eframe.Button;
import rust.eframe.RichText;
import rust.eframe.Color32;
import rust.eframe.Vec2;
import leaker.model.Invoice;
import leaker.model.InvoiceStatus;
import leaker.model.Date;
import leaker.model.Money;
import leaker.model.Percent;
import leaker.pdf.InvoicePdf;

public class InvoiceEditor {
    private Session session;
    private Invoice? invoice = null;

    private int productIndex = 0;
    private String issueText = "";
    private String dueText = "";
    private String dateError = "";
    private String lastPdf = "";

    public InvoiceEditor(Session session) {
        this.session = session;
    }

    public void load(Invoice inv) {
        invoice = inv;
        productIndex = 0;
        issueText = inv.issueDate.iso();
        dueText = inv.dueDate.iso();
        dateError = "";
        lastPdf = "";
    }

    /** Draws the editor. Returns false once the user asked to go back. */
    public bool show(Ui ui) {
        if (invoice == null) {
            return false;
        }
        var inv = invoice!!;
        bool editable = inv.status.isEditable();
        bool open = true;

        ui.horizontal((row) -> {
            if (row.button("< Back").clicked()) {
                open = false;
            }
            row.add_space(8.0f);
            row.heading($"Invoice ${inv.number}");
            String status = inv.isOverdue(session.today) ? "Overdue" : inv.status.label();
            row.label(new RichText(status).strong().size(15.0f).color(Palette.status(status)));
        });
        ui.add_space(4.0f);
        ui.horizontal_wrapped((row) -> {
            if (row.add(new Button(new RichText("Generate PDF").color(Color32.WHITE)).fill(Palette.ACCENT)).clicked()) {
                generatePdf(inv);
            }
            if (inv.status != InvoiceStatus.Paid && row.button($"Mark as ${inv.status.next().label()}").clicked()) {
                inv.status = inv.status.next();
                session.info($"${inv.number} is now ${inv.status.label()}.");
            }
            if (inv.status != InvoiceStatus.Draft && row.button("Back to draft").clicked()) {
                inv.status = InvoiceStatus.Draft;
                session.info($"${inv.number} is a draft again and can be edited.");
            }
            if (row.add(new Button(new RichText("Delete").color(Color32.WHITE)).fill(Palette.DANGER)).clicked()) {
                session.store.deleteInvoice(inv.number);
                session.info($"Deleted ${inv.number}.");
                invoice = null;
                open = false;
            }
        });
        if (!open) {
            return false;
        }
        ui.add_space(8.0f);

        // Totals beside the invoice in a wide window, under it in a narrow one.
        var totals = ui.available_width() >= 900.0f
            ? Panel.right(new Id("invoice-totals")).resizable(false).exact_size(280.0f)
            : Panel.bottom(new Id("invoice-totals-below")).resizable(false);
        totals.show(ui, (panel) -> showTotals(panel, inv));

        showHeader(ui, inv, editable);
        ui.add_space(8.0f);
        showLines(ui, inv, editable);
        return true;
    }

    private void showHeader(Ui ui, Invoice inv, bool editable) {
        ui.group((box) -> {
            new Grid("invoice-header").num_columns(4).spacing(new Vec2(16.0f, 8.0f)).show(box, (grid) -> {
                grid.label("Bill to");
                if (editable) {
                    ComboBox.from_id_salt("bill-to").selected_text(inv.customer.name).width(240.0f).show_ui(grid, (menu) -> {
                        for (var c : session.store.customers) {
                            if (menu.selectable_label(c.id == inv.customer.id, c.name).clicked()) {
                                inv.customer = c;
                            }
                        }
                    });
                } else {
                    grid.strong(inv.customer.name);
                }
                grid.label("Issue date");
                if (editable) {
                    grid.add(TextEdit.singleline(issueText).desired_width(110.0f));
                } else {
                    grid.label(inv.issueDate.iso());
                }
                grid.end_row();

                grid.label("");
                grid.vertical((addr) -> {
                    for (var part : inv.customer.addressLines()) {
                        addr.weak(part);
                    }
                    addr.weak(inv.customer.email);
                });
                grid.label("Due date");
                grid.vertical((cell) -> {
                    if (editable) {
                        cell.add(TextEdit.singleline(dueText).desired_width(110.0f));
                        if (dateError.length() > 0) {
                            cell.colored_label(Palette.DANGER, dateError);
                        }
                    } else {
                        cell.label(inv.dueDate.iso());
                    }
                    cell.weak($"Terms: ${inv.issueDate.daysUntil(inv.dueDate)} days");
                });
                grid.end_row();

                grid.label("Notes");
                if (editable) {
                    grid.add(TextEdit.multiline(inv.notes).desired_rows(2).desired_width(320.0f));
                } else {
                    grid.label(inv.notes);
                }
                grid.end_row();
            });
        });
        if (editable) {
            applyDates(inv);
        }
    }

    private void applyDates(Invoice inv) {
        var issue = Date.parse(issueText);
        var due = Date.parse(dueText);
        if (issue == null || due == null) {
            dateError = "Dates are YYYY-MM-DD.";
            return;
        }
        if (due!!.isBefore(issue!!)) {
            dateError = "Due date is before the issue date.";
            return;
        }
        dateError = "";
        inv.issueDate = issue!!;
        inv.dueDate = due!!;
    }

    private void showLines(Ui ui, Invoice inv, bool editable) {
        int removeAt = -1;
        if (editable) {
            ui.horizontal((row) -> {
                row.label("Add");
                String current = session.store.products.len() == 0 ? "(no products)" : describe(productIndex);
                ComboBox.from_id_salt("add-product").selected_text(current).width(320.0f).show_ui(row, (menu) -> {
                    int i = 0;
                    for (var p : session.store.products) {
                        menu.selectable_value(productIndex, i, describe(i));
                        i++;
                    }
                });
                if (row.add(new Button(new RichText("Add line").color(Color32.WHITE)).fill(Palette.ACCENT)).clicked()) {
                    addLine(inv);
                }
            });
            ui.add_space(6.0f);
        }

        ScrollArea.vertical().auto_shrink(false).show(ui, (scroll) -> {
            new Grid("invoice-lines").striped(true).num_columns(editable ? 7 : 6).min_col_width(60.0f).show(scroll, (grid) -> {
                if (editable) {
                    grid.label("");
                }
                grid.strong("Item");
                grid.strong("Qty");
                grid.strong("Unit price");
                grid.strong("Disc.");
                grid.strong("Tax");
                grid.strong("Line total");
                grid.end_row();

                int i = 0;
                for (var line : inv.lines) {
                    if (editable && grid.small_button("x").on_hover_text("Remove this line").clicked()) {
                        removeAt = i;
                    }
                    grid.vertical((cell) -> {
                        cell.set_min_width(180.0f);
                        cell.label(line.description);
                        cell.small(line.product.sku);
                    });
                    if (editable) {
                        grid.add(new DragValue(line.quantity).range(1..=9999).speed(0.1));
                        long cents = line.unitPrice.cents;
                        grid.add(new DragValue(cents)
                            .range(0..=100000000)
                            .speed(5.0)
                            .custom_formatter((value, decimals) -> Money.ofCents((long) value).format())
                            .custom_parser((text) -> {
                                var m = Money.parse(text);
                                return m == null ? null : (double) m!!.cents;
                            }));
                        line.unitPrice = Money.ofCents(cents);
                        grid.add(new DragValue(line.discount)
                            .range(0..=10000)
                            .speed(10.0)
                            .custom_formatter((value, decimals) -> Percent.format((int) value))
                            .custom_parser((text) -> {
                                var bp = Percent.parse(text);
                                return bp == null ? null : (double) bp!!;
                            }));
                    } else {
                        grid.label($"${line.quantity}");
                        grid.label(line.unitPrice.format());
                        grid.label(line.discount == 0 ? "-" : Percent.format(line.discount));
                    }
                    grid.weak(Percent.format(line.taxRate));
                    Cells.amount(grid, 90.0f, new RichText(line.total().format()).strong());
                    grid.end_row();
                    i++;
                }
            });
            if (inv.lines.len() == 0) {
                scroll.weak(editable ? "No lines yet: pick a product above and add it." : "No lines.");
            }
        });

        if (removeAt >= 0) {
            var gone = inv.lines[removeAt];
            inv.removeLine(removeAt);
            session.info($"Removed ${gone.description}.");
        }
    }

    private String describe(int productIndex) {
        var p = session.store.products[productIndex];
        return $"${p.sku}  ${p.name}  ${p.unitPrice}";
    }

    private void addLine(Invoice inv) {
        if (session.store.products.len() == 0) {
            session.error("The catalogue is empty; add a product first.");
            return;
        }
        if (productIndex < 0 || productIndex >= session.store.products.len()) {
            productIndex = 0;
        }
        var product = session.store.products[productIndex];
        // Adding a product that is already on the invoice bumps its quantity.
        for (var line : inv.lines) {
            if (line.product.id == product.id) {
                line.quantity++;
                session.info($"${product.name}: quantity is now ${line.quantity}.");
                return;
            }
        }
        inv.addLine(product, 1);
        session.info($"Added ${product.name}.");
    }

    private void showTotals(Ui ui, Invoice inv) {
        var t = inv.totals();
        ui.add_space(4.0f);
        ui.label(new RichText("Totals").strong().size(15.0f));
        ui.add_space(6.0f);
        new Grid("invoice-totals-grid").num_columns(2).spacing(new Vec2(24.0f, 6.0f)).show(ui, (grid) -> {
            grid.weak("Subtotal");
            grid.label(t.subtotal.display());
            grid.end_row();
            grid.weak("Discount");
            grid.label($"-${t.discount}");
            grid.end_row();
            grid.weak("Tax");
            grid.label(t.tax.display());
            grid.end_row();
            grid.label(new RichText("Total due").strong().size(15.0f));
            grid.label(new RichText(t.total.display()).strong().size(18.0f).color(Palette.ACCENT));
            grid.end_row();
        });
        if (lastPdf.length() > 0) {
            ui.add_space(10.0f);
            ui.weak("Last PDF:");
            ui.colored_label(Palette.ACCENT, lastPdf);
        }
    }

    private void generatePdf(Invoice inv) {
        if (inv.lines.len() == 0) {
            session.error("Add at least one line before generating a PDF.");
            return;
        }
        try {
            String path = new InvoicePdf(session.company).save(inv, "invoices");
            lastPdf = path;
            session.info($"Saved ${path}");
        } catch (Exception e) {
            session.error($"Could not write the PDF: ${e.getMessage()}");
        }
    }
}

// The window: side navigation, the current screen, and the status line.
package leaker.ui;

import rust.eframe.Ui;
import rust.eframe.Panel;
import rust.eframe.CentralPanel;
import rust.eframe.Id;
import rust.eframe.RichText;
import rust.eframe.Layout;
import rust.eframe.Align;

public class App {
    private Session session;
    private Screen current = Screen.Dashboard;
    private bool styled = false;

    private OverviewScreen overview;
    private CustomersScreen customers;
    private ProductsScreen products;
    private InvoicesScreen invoices;

    public App(Session session) {
        this.session = session;
        this.overview = new OverviewScreen(session);
        this.customers = new CustomersScreen(session);
        this.products = new ProductsScreen(session);
        this.invoices = new InvoicesScreen(session);
    }

    /**
     * Picks the first screen, for `--screen`: overview, customers, products,
     * invoices, or an invoice number to open straight in the editor.
     */
    public void start(String screen) {
        switch (screen) {
            case "overview" -> current = Screen.Dashboard;
            case "customers" -> current = Screen.Customers;
            case "products" -> current = Screen.Products;
            default -> {
                current = Screen.Invoices;
                if (screen.starts_with("INV-")) {
                    invoices.open(screen);
                }
            }
        }
    }

    /** One frame. eframe calls this for every repaint. */
    public void frame(Ui ui) {
        if (!styled) {
            ui.ctx().set_visuals(Palette.visuals());
            styled = true;
        }

        Panel.left(new Id("nav"))
            .resizable(true)
            .default_size(200.0f)
            .min_size(150.0f)
            .max_size(320.0f)
            .show(ui, (nav) -> showNav(nav));

        Panel.bottom(new Id("status")).show(ui, (bar) -> {
            var color = session.statusIsError ? Palette.DANGER
                : session.statusAgeSeconds() < 4 ? Palette.SUCCESS : Palette.MUTED;
            bar.colored_label(color, session.status);
        });

        CentralPanel.default_margins().show(ui, (main) -> {
            switch (current) {
                case Screen.Dashboard -> {
                    String? opened = overview.show(main);
                    if (opened != null) {
                        current = Screen.Invoices;
                        invoices.open(opened!!);
                    }
                }
                case Screen.Customers -> customers.show(main);
                case Screen.Products -> products.show(main);
                case Screen.Invoices -> invoices.show(main);
            }
        });
    }

    private void showNav(Ui nav) {
        nav.add_space(8.0f);
        nav.label(new RichText("Leaker").size(22.0f).strong().color(Palette.ACCENT));
        nav.label(new RichText("Invoicing, in Jux").size(12.0f).color(Palette.MUTED));
        nav.add_space(20.0f);
        for (var s : Screen.values()) {
            var text = new RichText(s.title()).size(15.0f);
            if (nav.selectable_label(s == current, text).clicked()) {
                current = s;
                if (s == Screen.Invoices) {
                    invoices.closeEditor();
                }
            }
            nav.add_space(4.0f);
        }
        nav.with_layout(Layout.bottom_up(Align.Min), (foot) -> {
            foot.label(new RichText($"Outstanding ${session.store.outstanding()}").size(12.0f).color(Palette.MUTED));
            foot.label(new RichText($"Today ${session.today}").size(12.0f).color(Palette.MUTED));
        });
    }
}

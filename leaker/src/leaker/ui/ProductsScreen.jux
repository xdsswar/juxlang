// Products: the catalogue, and a form to add or change an entry.
package leaker.ui;

import rust.eframe.Ui;
import rust.eframe.Panel;
import rust.eframe.Id;
import rust.eframe.Grid;
import rust.eframe.ScrollArea;
import rust.eframe.RichText;
import rust.eframe.TextEdit;
import rust.eframe.Button;
import rust.eframe.Color32;
import rust.eframe.Vec2;
import leaker.model.Money;
import leaker.model.Percent;
import leaker.model.Product;

public class ProductsScreen {
    private Session session;
    private int selectedId = 0;

    private String sku = "";
    private String name = "";
    private String price = "";
    private String taxRate = "20%";
    private String skuError = "";
    private String nameError = "";
    private String priceError = "";
    private String taxError = "";

    public ProductsScreen(Session session) {
        this.session = session;
    }

    public void show(Ui ui) {
        ui.horizontal((row) -> {
            row.heading("Products");
            row.add_space(12.0f);
            row.weak($"${session.store.products.len()} in the catalogue");
            row.add_space(12.0f);
            if (row.button("+ New product").clicked()) {
                startNew();
            }
        });
        ui.add_space(6.0f);

        var form = ui.available_width() >= 900.0f
            ? Panel.right(new Id("product-form")).resizable(true).default_size(380.0f).min_size(340.0f)
            : Panel.bottom(new Id("product-form-below")).resizable(true).default_size(320.0f);
        form.show(ui, (panel) -> showForm(panel));

        ScrollArea.vertical().auto_shrink(false).show(ui, (scroll) -> {
            new Grid("products").striped(true).num_columns(4).min_col_width(70.0f).show(scroll, (grid) -> {
                grid.strong("SKU");
                grid.strong("Name");
                grid.strong("Unit price");
                grid.strong("Tax");
                grid.end_row();
                for (var p : session.store.products) {
                    if (grid.selectable_label(p.id == selectedId, p.sku).clicked()) {
                        select(p);
                    }
                    grid.label(p.name);
                    Cells.amount(grid, 80.0f, new RichText(p.unitPrice.format()));
                    Cells.amount(grid, 50.0f, new RichText(Percent.format(p.taxRate)));
                    grid.end_row();
                }
            });
        });
    }

    private void showForm(Ui ui) {
        ui.add_space(8.0f);
        ui.label(new RichText(selectedId == 0 ? "New product" : $"Edit product #${selectedId}").strong().size(15.0f));
        ui.add_space(8.0f);
        new Grid("product-fields").num_columns(2).spacing(new Vec2(12.0f, 8.0f)).show(ui, (grid) -> {
            grid.label("SKU");
            grid.vertical((cell) -> {
                cell.add(TextEdit.singleline(sku).desired_width(220.0f));
                showError(cell, skuError);
            });
            grid.end_row();
            grid.label("Name");
            grid.vertical((cell) -> {
                cell.add(TextEdit.singleline(name).desired_width(220.0f));
                showError(cell, nameError);
            });
            grid.end_row();
            grid.label("Unit price");
            grid.vertical((cell) -> {
                cell.add(TextEdit.singleline(price).desired_width(220.0f));
                showError(cell, priceError);
            });
            grid.end_row();
            grid.label("Tax rate");
            grid.vertical((cell) -> {
                cell.add(TextEdit.singleline(taxRate).desired_width(220.0f));
                showError(cell, taxError);
            });
            grid.end_row();
        });

        // A live preview of what one unit costs with tax, as the user types.
        var net = Money.parse(price);
        var rate = Percent.parse(taxRate);
        if (net != null && rate != null) {
            var gross = net!! + net!!.percent(rate!!);
            ui.weak($"One unit with tax: ${gross}");
        }

        ui.add_space(12.0f);
        ui.horizontal((row) -> {
            if (row.add(new Button(new RichText(selectedId == 0 ? "Add product" : "Save changes").color(Color32.WHITE)).fill(Palette.ACCENT)).clicked()) {
                save();
            }
            if (row.button("Clear").clicked()) {
                startNew();
            }
            if (selectedId != 0) {
                row.add_space(24.0f);
                if (row.add(new Button(new RichText("Delete").color(Color32.WHITE)).fill(Palette.DANGER)).clicked()) {
                    delete();
                }
            }
        });
    }

    /** A field's validation message, under the field. */
    private void showError(Ui ui, String error) {
        if (error.length() > 0) {
            ui.colored_label(Palette.DANGER, error);
        }
    }

    private void startNew() {
        selectedId = 0;
        sku = "";
        name = "";
        price = "";
        taxRate = "20%";
        clearErrors();
    }

    private void clearErrors() {
        skuError = "";
        nameError = "";
        priceError = "";
        taxError = "";
    }

    private void select(Product p) {
        selectedId = p.id;
        sku = p.sku;
        name = p.name;
        price = p.unitPrice.format();
        taxRate = Percent.format(p.taxRate);
        clearErrors();
    }

    private void save() {
        clearErrors();
        String cleanSku = sku.trim().to_uppercase();
        if (cleanSku.length() == 0) {
            skuError = "A SKU is required.";
        }
        for (var other : session.store.products) {
            if (other.sku == cleanSku && other.id != selectedId) {
                skuError = $"${cleanSku} is already used by ${other.name}.";
            }
        }
        if (name.trim().length() == 0) {
            nameError = "A name is required.";
        }
        var parsedPrice = Money.parse(price);
        if (parsedPrice == null || parsedPrice!!.isNegative()) {
            priceError = "Enter an amount such as 49.90.";
        }
        var parsedRate = Percent.parse(taxRate);
        if (parsedRate == null) {
            taxError = "Enter a rate between 0% and 100%.";
        }
        if (skuError.length() > 0 || nameError.length() > 0 || priceError.length() > 0 || taxError.length() > 0) {
            session.error("Please fix the highlighted fields.");
            return;
        }

        if (selectedId == 0) {
            var p = session.store.addProduct(cleanSku, name.trim(), parsedPrice!!, parsedRate!!);
            select(p);
            session.info($"Added ${p.sku} ${p.name}.");
            return;
        }
        var existing = session.store.findProduct(selectedId);
        if (existing == null) {
            session.error("That product no longer exists.");
            startNew();
            return;
        }
        var p = existing!!;
        p.sku = cleanSku;
        p.name = name.trim();
        p.unitPrice = parsedPrice!!;
        p.taxRate = parsedRate!!;
        sku = cleanSku;
        session.info($"Saved ${p.sku}. Existing invoice lines keep the price they were billed at.");
    }

    private void delete() {
        var existing = session.store.findProduct(selectedId);
        if (existing == null) {
            startNew();
            return;
        }
        String what = existing!!.sku;
        session.store.deleteProduct(selectedId);
        session.info($"Deleted ${what}. Invoices that used it are unchanged.");
        startNew();
    }
}

// What the user has typed into one invoice line's inputs.
//
// Kept apart from the LineItem so a half-typed quantity ("1" on its way to
// "12", or an empty field) is not thrown away on the next frame: the line is
// only updated when the text parses.
package leaker.ui;

import leaker.model.LineItem;
import leaker.model.Money;
import leaker.model.Percent;

public class LineDraft {
    public String quantity;
    public String unitPrice;
    public String discount;
    public bool valid = true;

    public LineDraft(LineItem line) {
        this.quantity = $"${line.quantity}";
        this.unitPrice = line.unitPrice.format();
        this.discount = line.discount == 0 ? "0" : Percent.format(line.discount);
    }

    /** Copies whatever parses into the line; remembers whether all of it did. */
    public void applyTo(LineItem line) {
        valid = true;
        try {
            long q = quantity.trim().parse<long>();
            if (q > 0) {
                line.quantity = q;
            } else {
                valid = false;
            }
        } catch (Exception e) {
            valid = false;
        }
        var p = Money.parse(unitPrice);
        if (p != null && !p!!.isNegative()) {
            line.unitPrice = p!!;
        } else {
            valid = false;
        }
        var d = Percent.parse(discount);
        if (d != null) {
            line.discount = d!!;
        } else {
            valid = false;
        }
    }
}

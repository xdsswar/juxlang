// One page's drawing commands, in PDF content-stream syntax.
//
// The page uses a top-left origin like a screen does (y grows downward), and
// flips to PDF's bottom-left origin as it writes each operator, so layout
// code reads top to bottom the way the invoice does.
package leaker.pdf;

public class PdfPage {
    public double width;
    public double height;
    private String ops = "";
    private FontMetrics metrics;

    public PdfPage(double width, double height, FontMetrics metrics) {
        this.width = width;
        this.height = height;
        this.metrics = metrics;
    }

    public String content() {
        return ops;
    }

    /** Text with its baseline at (x, y), y measured from the top. */
    public void text(double x, double y, String text, double size, bool bold, PdfColor color) {
        String font = bold ? "F2" : "F1";
        ops += $"BT ${color.fillOp()} /${font} ${num(size)} Tf ${num(x)} ${num(height - y)} Td (${escape(text)}) Tj ET\n";
    }

    /** Text whose right edge is at `right`. */
    public void textRight(double right, double y, String text, double size, bool bold, PdfColor color) {
        double w = metrics.textWidth(text, size, bold);
        this.text(right - w, y, text, size, bold, color);
    }

    public double textWidth(String text, double size, bool bold) {
        return metrics.textWidth(text, size, bold);
    }

    /**
     * Text wrapped to `maxWidth`, one line every `leading` points. Returns the
     * y of the line after the last one written.
     */
    public double paragraph(double x, double y, double maxWidth, String text, double size, double leading, PdfColor color) {
        double cy = y;
        String line = "";
        for (var word : text.split(" ")) {
            String candidate = line.length() == 0 ? $"${word}" : line + " " + word;
            if (line.length() > 0 && metrics.textWidth(candidate, size, false) > maxWidth) {
                this.text(x, cy, line, size, false, color);
                cy += leading;
                line = word;
            } else {
                line = candidate;
            }
        }
        if (line.length() > 0) {
            this.text(x, cy, line, size, false, color);
            cy += leading;
        }
        return cy;
    }

    public void line(double x1, double y1, double x2, double y2, double lineWidth, PdfColor color) {
        ops += $"${color.strokeOp()} ${num(lineWidth)} w ${num(x1)} ${num(height - y1)} m ${num(x2)} ${num(height - y2)} l S\n";
    }

    /** A filled rectangle whose top-left corner is (x, y). */
    public void fillRect(double x, double y, double w, double h, PdfColor color) {
        ops += $"${color.fillOp()} ${num(x)} ${num(height - y - h)} ${num(w)} ${num(h)} re f\n";
    }

    public void strokeRect(double x, double y, double w, double h, double lineWidth, PdfColor color) {
        ops += $"${color.strokeOp()} ${num(lineWidth)} w ${num(x)} ${num(height - y - h)} ${num(w)} ${num(h)} re S\n";
    }

    /** A number as PDF wants it: at most two decimals, no exponent. */
    public static String num(double v) {
        long hundredths = (long) (v * 100.0 + (v >= 0.0 ? 0.5 : -0.5));
        bool neg = hundredths < 0;
        long a = neg ? -hundredths : hundredths;
        long whole = a / 100;
        long frac = a % 100;
        String sign = neg ? "-" : "";
        if (frac == 0) {
            return $"${sign}${whole}";
        }
        String f = frac < 10 ? $"0${frac}" : $"${frac}";
        return $"${sign}${whole}.${f}";
    }

    /**
     * A string literal body. The standard fonts use WinAnsi encoding, so
     * Latin-1 letters and a few typographic marks are written as octal
     * escapes; that keeps the whole file 7-bit, which is what lets it be
     * built as an ordinary String.
     */
    public static String escape(String text) {
        String out = "";
        for (var ch : text.chars()) {
            int code = (int) ch;
            if (ch == '(' || ch == ')' || ch == '\\') {
                out += "\\" + $"${ch}";
            } else if (code >= 32 && code < 127) {
                out += $"${ch}";
            } else if (code >= 160 && code <= 255) {
                out += octal(code);
            } else if (code == 8364) {
                out += octal(128);  // euro sign
            } else if (code == 8211) {
                out += octal(150);  // en dash
            } else if (code == 8212) {
                out += octal(151);  // em dash
            } else if (code == 8226) {
                out += octal(149);  // bullet
            } else {
                out += "?";
            }
        }
        return out;
    }

    private static String octal(int code) {
        int a = code / 64;
        int b = (code / 8) % 8;
        int c = code % 8;
        return $"\\${a}${b}${c}";
    }
}

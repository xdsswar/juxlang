// Glyph widths of the two standard PDF fonts the invoice uses.
//
// Helvetica and Helvetica-Bold are among the 14 fonts every PDF reader
// carries, so the file embeds no font at all. To right-align a number, though,
// the writer has to know how wide it will be; these are the widths from
// Adobe's AFM files, in 1/1000 of the font size, for ASCII 32..126.
package leaker.pdf;

public class FontMetrics {
    private int[] regular;
    private int[] bold;

    public FontMetrics() {
        int[] r = {
            278, 278, 355, 556, 556, 889, 667, 191, 333, 333, 389, 584, 278, 333, 278, 278,
            556, 556, 556, 556, 556, 556, 556, 556, 556, 556, 278, 278, 584, 584, 584, 556,
            1015, 667, 667, 722, 722, 667, 611, 778, 722, 278, 500, 667, 556, 833, 722, 778,
            667, 778, 722, 667, 611, 722, 667, 944, 667, 667, 611, 278, 278, 278, 469, 556,
            333, 556, 556, 500, 556, 556, 278, 556, 556, 222, 222, 500, 222, 833, 556, 556,
            556, 556, 333, 500, 278, 556, 500, 722, 500, 500, 500, 334, 260, 334, 584
        };
        regular = r;
        int[] b = {
            278, 333, 474, 556, 556, 889, 722, 238, 333, 333, 389, 584, 278, 333, 278, 278,
            556, 556, 556, 556, 556, 556, 556, 556, 556, 556, 333, 333, 584, 584, 584, 611,
            975, 722, 722, 722, 722, 667, 611, 778, 722, 278, 556, 722, 611, 833, 722, 778,
            667, 778, 722, 667, 611, 722, 667, 944, 667, 667, 611, 333, 278, 333, 584, 556,
            333, 556, 611, 556, 611, 556, 333, 611, 611, 278, 278, 556, 278, 889, 611, 611,
            611, 611, 389, 556, 333, 611, 556, 778, 556, 556, 500, 389, 280, 389, 584
        };
        bold = b;
    }

    /** Width of one character in 1/1000 em. Anything outside ASCII counts as a digit. */
    public int charWidth(char ch, bool isBold) {
        int code = (int) ch;
        if (code < 32 || code > 126) {
            return 556;
        }
        return isBold ? bold[code - 32] : regular[code - 32];
    }

    /** Width of `text` in points at `size`. */
    public double textWidth(String text, double size, bool isBold) {
        int units = 0;
        for (var ch : text.chars()) {
            units += charWidth(ch, isBold);
        }
        return (double) units * size / 1000.0;
    }
}

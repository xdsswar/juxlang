// A minimal PDF 1.4 writer.
//
// Why this exists: the plan was a Rust PDF crate, and three were tried
// (printpdf 0.12, lopdf 0.45, genpdf 0.2). None of them can be driven from
// Jux as it stands; LEAKS.md has the details. What a PDF needs for an invoice
// is small, though: a catalog, a page tree, two standard fonts, and a content
// stream per page. That is plain text plus a table of byte offsets, which
// Jux can write on its own.
package leaker.pdf;

public class PdfDocument {
    public static const double A4_WIDTH = 595.28;
    public static const double A4_HEIGHT = 841.89;

    public String title;
    public Vec<PdfPage> pages = new Vec<PdfPage>();
    private FontMetrics metrics = new FontMetrics();

    public PdfDocument(String title) {
        this.title = title;
    }

    public PdfPage addPage() {
        var page = new PdfPage(A4_WIDTH, A4_HEIGHT, metrics);
        pages.push(page);
        return page;
    }

    /**
     * The whole file. Objects are numbered 1 catalog, 2 page tree, 3 and 4 the
     * fonts, 5 the info dictionary, then a page and its content stream for
     * each page. Every character written is 7-bit, so a String's length is
     * the byte offset the cross-reference table needs.
     */
    public String render() {
        int pageCount = pages.len();
        var offsets = new Vec<int>();
        // No binary-marker comment: it would be the only non-ASCII line, and
        // it is optional. Everything below is measured from the header's end.
        String header = "%PDF-1.4\n";
        int headerBytes = header.length();
        String body = "";

        String kids = "";
        for (int i = 0; i < pageCount; i++) {
            kids += $"${6 + i * 2} 0 R ";
        }

        offsets.push(headerBytes + body.length());
        body += "1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n";

        offsets.push(headerBytes + body.length());
        body += $"2 0 obj\n<< /Type /Pages /Kids [ ${kids}] /Count ${pageCount} >>\nendobj\n";

        offsets.push(headerBytes + body.length());
        body += "3 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>\nendobj\n";

        offsets.push(headerBytes + body.length());
        body += "4 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>\nendobj\n";

        offsets.push(headerBytes + body.length());
        body += $"5 0 obj\n<< /Title (${PdfPage.escape(title)}) /Producer (Leaker, written in Jux) >>\nendobj\n";

        int n = 6;
        for (var page : pages) {
            String content = page.content();
            offsets.push(headerBytes + body.length());
            body += $"${n} 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${PdfPage.num(page.width)} ${PdfPage.num(page.height)}] ";
            body += $"/Resources << /Font << /F1 3 0 R /F2 4 0 R >> >> /Contents ${n + 1} 0 R >>\nendobj\n";
            offsets.push(headerBytes + body.length());
            body += $"${n + 1} 0 obj\n<< /Length ${content.length()} >>\nstream\n${content}endstream\nendobj\n";
            n += 2;
        }

        int xrefAt = headerBytes + body.length();
        int count = offsets.len() + 1;
        String xref = $"xref\n0 ${count}\n0000000000 65535 f \n";
        for (var off : offsets) {
            xref += pad10(off) + " 00000 n \n";
        }
        String trailer = $"trailer\n<< /Size ${count} /Root 1 0 R /Info 5 0 R >>\nstartxref\n${xrefAt}\n%%EOF\n";
        return header + body + xref + trailer;
    }

    private static String pad10(int v) {
        String s = $"${v}";
        while (s.length() < 10) {
            s = "0" + s;
        }
        return s;
    }
}

=== List<T> methods ===
size       = 3
length     = 3
isEmpty    = false
contains 20 = true
contains 99 = false
indexOf 30 = 2
indexOf 99 = -1
first      = 10
last       = 30
get(1)     = 20
after add(6) -> size=6, last=6
after remove(0) -> first=2, size=5
after insert(0, 99) -> first=99, size=6
after reverse -> first=6, last=99
after sort -> first=2, last=99
after clear -> isEmpty=true

length     = 21
trimmed    = 'Hello, Jux World!'
upper      =   HELLO, JUX WORLD!
lower      =   hello, jux world!
contains J = true
startsWith = true
endsWith   = true
indexOf J  = 9
replace    = Hello, Rust World!
substring  = 'Jux'
charAt(0)  = H
isEmpty    = false
empty.isEmpty = true
split size = 2
split[0]   = 'Hello'

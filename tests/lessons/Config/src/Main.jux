// A build knows several things about itself: the system it is for, whether it
// is a debug or a release build, which profile it uses. In Jux all of them are
// predicates of `@cfg(...)` on a declaration and `if cfg(...)` inside a body
// (JUX-LANG-V1 §11), decided while compiling.
//
// Only the branch that holds reaches the binary. The others are parsed and
// then gone: not skipped at run time, absent.

// Jux describes the target with predicates rather than values, so a question about the target is asked by
// declaring the answer once per case. Exactly one of each pair survives.
@cfg(any(os = "windows", os = "linux", os = "macos", os = "freebsd"))
String system() {
    return "a desktop operating system";
}

@cfg(not(any(os = "windows", os = "linux", os = "macos", os = "freebsd")))
String system() {
    return "something other than a desktop";
}

@cfg(pointer_width = "64")
String width() {
    return "64-bit";
}

@cfg(not(pointer_width = "64"))
String width() {
    return "not 64-bit";
}

// A helper that reports its caller's file and function would need a query
// the compiler fills in where the call appears. Jux has no such query (a gap listed in
// the README), so here the function name is passed in, which is exactly the
// hand-typing `#source` exists to avoid.
void trace(String function, String message) {
    print($"  [Main.jux in ${function}] ${message}");
}

void main() {
    // The target being built for. These predicates hold on every desktop
    // build this lesson is run on, so its transcript is the same everywhere;
    // `jux run --target <triple>` decides them for that target instead.
    print($"compiled for ${system()}, ${width()}");

    // The build mode. `jux run` makes a debug build unless it is given
    // `--release`, so this prints the first line; a release build prints the
    // second, and the first is not in its binary at all.
    if cfg(debug) {
        print("debug build: extra checking is worth its cost here");
    } else {
        print("release build: the checks above were never compiled in");
    }

    // Jux ties the optimizer's goal to the build mode: `debug` means not optimized and `release`
    // means optimized (§11.6.1), so the same predicate answers both.
    if cfg(debug) {
        print("optimization: none, so the output follows the source closely");
    } else {
        print("optimization: speed");
    }

    // The profile says how much
    // of the language and runtime the target can carry (`[build] profile` in
    // jux.toml). An ordinary program is `full`.
    if cfg(profile = "full") {
        print("profile: full");
    } else if cfg(profile = "embedded") {
        print("profile: embedded");
    } else {
        print("profile: core");
    }

    print("source location:");
    trace("main", "this message knows where it came from");

    // A build can switch named features on and off:
    // features are declared in jux.toml and tested with `feature = "name"`.
    if cfg(feature = "verbose") {
        print("feature verbose: on");
    } else {
        print("feature verbose: off (try `jux run --features verbose`)");
    }
}

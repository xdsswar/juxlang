// A second source file in the same project. The `package` line says where its
// contents live, and the directory mirrors it: `lessons/module/geometry/` holds
// `package lessons.module.geometry` (Jux §3.1).
//
// A file of functions declares no public type, so it may be named anything.
// Two files could even contribute to one package; the `package` line, not the
// file, decides where these functions live.

package lessons.module.geometry;

// `public` is what makes a function reachable from other packages. Main is in
// a different package, so these three need it.
public int rectangleArea(int width, int height) {
    return width * height;
}

public int squareArea(int side) {
    return rectangleArea(side, side);
}

// A package is also a namespace, so this name cannot collide with a
// `describe` in another package.
public int perimeter(int width, int height) {
    return 2 * (width + height);
}

public String describe() {
    return "areas and perimeters";
}

// Without a modifier a function is package-private: any file in
// `lessons.module.geometry` may call it, and nothing outside may. Main could not
// import this one, which is the point: it is a detail of this package.
int doubled(int value) {
    return value * 2;
}

// Calls the package-private helper, to show it is usable inside the package.
public int twiceTheArea(int width, int height) {
    return doubled(rectangleArea(width, height));
}

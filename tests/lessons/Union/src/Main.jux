// A variant (a Jux enum with payloads) records which case is active, so
// reading the wrong one is impossible. A union does not. Its members share
// one piece of storage, and nothing remembers which was written last.
//
// That is not a weaker variant; it is a different tool. Writing one member and
// reading another reinterprets the same bytes rather than converting them,
// which is how a number's bit pattern is examined directly.
//
// GAP: Jux has no `union` declaration. Rux's
//
//     union Bits { asSigned: int32, asUnsigned: uint32, asBytes: uint8[4] }
//
// has no Jux spelling: `union` is not a keyword, so the line is read as a
// function returning a type named `union` and fails with E0417 and E0200.
// What Jux does have is the operation a union exists for: reading the bytes
// of a value as another type. Inside `unsafe`, a pointer to the value can be
// cast to a pointer to any other type (Layout-ABI §L.6), and reading through
// it rereads the same storage. This lesson uses that, with each union member
// becoming one pointer type over a single `i32`.

// The size a union would have: that of its largest member, not the sum of
// them, because the members overlap rather than sit side by side. Without a
// `union` to ask `sizeof` about, the rule is applied by hand.
int largest(int... sizes) {
    int result = 0;
    for (var size : sizes) {
        if (size > result) {
            result = size;
        }
    }
    return result;
}

// The three views of one piece of storage. The storage is the `i32` the
// pointer came from; nothing is copied or converted, only read differently.
public unsafe i32 asSigned(i32* storage) {
    return *storage;
}

public unsafe u32 asUnsigned(i32* storage) {
    return *(storage as u32*);
}

public unsafe String asBytes(i32* storage) {
    ubyte* bytes = storage as ubyte*;
    return $"${bytes[0]} ${bytes[1]} ${bytes[2]} ${bytes[3]}";
}

void main() {
    // Bits: an i32, a u32, or four bytes. Uneven: one byte or eight.
    // `sizeof` answers with an unsigned `uint` (§5.9.1), so each size is cast
    // to the `int` the helper takes.
    print($"sizeof(Bits)    ${largest(sizeof(i32) as int, sizeof(u32) as int, 4 * sizeof(ubyte) as int)}");
    print($"sizeof(Uneven)  ${largest(sizeof(ubyte) as int, sizeof(ulong) as int)}   (not 1 + 8)");

    // Construction wrote one member; the others are that same storage, read
    // a different way.
    i32 zero = 0;
    unsafe {
        print($"zero as signed   ${asSigned(&zero)}");
        print($"zero as unsigned ${asUnsigned(&zero)}");
    }

    // Minus one is every bit set. Read as unsigned that is the largest value
    // the type holds, and read as bytes it is four 255s. These are the same
    // bits, reread.
    i32 punned = -1;
    unsafe {
        print($"as signed        ${asSigned(&punned)}");
        print($"as unsigned      ${asUnsigned(&punned)}");
        print($"as bytes         ${asBytes(&punned)}");
    }

    // The same trick on a value with structure to see: 256 sets one bit in the
    // second byte, and the byte order of the machine decides which end it
    // appears at. On a little-endian machine it is the second from the left.
    i32 small = 256;
    unsafe {
        print($"256 as bytes     ${asBytes(&small)}");
    }

    // Nothing above was an error, and that is the point to be careful about.
    // Reading storage as another type is not a mistake the compiler can
    // catch; it is a reinterpretation of whatever bytes are there, which is
    // why Jux only allows it inside `unsafe`. If the program needs to know
    // which reading is meaningful, it has to track that itself, and at that
    // point an enum with payloads is the better answer.
}

// Playing a tune by asking the operating system to sound one note at a time.
//
// There is no portable way to do this, so the sound is platform specific,
// which makes it a small, honest example of calling a system API directly,
// and of admitting when something does not exist everywhere.
//
// A test cannot listen, so by default this lesson prints the notes instead of
// sounding them. `jux run --features sound` on Windows plays them as well.

// Windows provides `Beep(frequency, duration)` in kernel32, which is exactly
// the shape a note needs. `@cfg` keeps the declaration out of a build for any
// other system, where the symbol would not exist to link against. Jux simply
// leaves the sound out there.
@cfg(os = "windows")
@extern(lib = "kernel32")
unsafe native {
    // A Win32 `BOOL` is a C `int`, so the width-explicit `i32` at the
    // boundary; a `DWORD` is `u32`.
    i32 Beep(u32 frequency, u32 duration);
}

// Note frequencies in hertz, near the middle of a piano. Naming them keeps the
// tune below readable as music rather than as numbers.
const u32 C4 = 262;
const u32 D4 = 294;
const u32 E4 = 330;
const u32 F4 = 349;
const u32 G4 = 392;
const u32 A4 = 440;

// Sounds one note where that is possible and was asked for, and returns the
// text to show for it. The `if cfg` is decided while compiling: in a build
// without the `sound` feature (or off Windows) the call to `Beep` is not
// compiled at all, only parsed.
String play(String name, u32 frequency, u32 milliseconds) {
    if cfg(all(os = "windows", feature = "sound")) {
        unsafe {
            Beep(frequency, milliseconds);
        }
    }
    return $"${name} ";
}

void main() {
    print("Ode to Joy, roughly:");
    print("");

    // The tune as three parallel arrays: the notes, their names, and how long
    // each is held. A struct would be tidier, but this keeps the shape of the
    // data obvious.
    final u32[] notes = {
        E4, E4, F4, G4, G4, F4, E4, D4,
        C4, C4, D4, E4, E4, D4, D4, D4
    };
    final String[] names = {
        "E", "E", "F", "G", "G", "F", "E", "D",
        "C", "C", "D", "E", "E", "D", "D", "D"
    };
    final u32[] lengths = {
        400, 400, 400, 400, 400, 400, 400, 400,
        400, 400, 400, 400, 600, 200, 400, 800
    };

    // `print` always ends the line, so the notes are gathered into one line
    // and printed together.
    var tune = "";
    for (int i = 0; i < notes.length; i++) {
        tune += play(names[i], notes[i], lengths[i]);
    }
    print(tune);
    print("");

    // A rising scale, to hear the frequencies climb.
    print("and a scale:");
    final u32[] scale = { C4, D4, E4, F4, G4, A4 };
    final String[] scaleNames = { "C", "D", "E", "F", "G", "A" };
    var climb = "";
    for (int i = 0; i < scale.length; i++) {
        climb += play(scaleNames[i], scale[i], 250);
    }
    print(climb);

    // Worth noticing what `Beep` is: a call straight into the operating
    // system, declared here and linked from a DLL, with no library in between.
    // That is the same mechanism the Extern lesson covers, used for something
    // the standard library deliberately does not wrap, because a beep is not
    // a thing every platform has.
}

// A second package, in its own file. Its `describe` and Geometry's can never
// be confused, because each is reached through its own package.

package rux.module.temperature;

public double toFahrenheit(double celsius) {
    return celsius * 9.0 / 5.0 + 32.0;
}

public double toCelsius(double fahrenheit) {
    return (fahrenheit - 32.0) * 5.0 / 9.0;
}

public String describe() {
    return "degrees, both ways";
}

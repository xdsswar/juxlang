// Writing something to a file and reading it back: the whole round trip,
// with the failures that can happen at each step.
//
// Every operation here can fail for reasons outside the program: the disk is
// full, the name is taken, permission is refused. In Rust each one returns a
// `Result`; reached from Jux, each one `throws` the `std::io::Error` instead,
// so a single `try` covers the round trip and the `catch` says which step
// went wrong. `File`, its `read` and `write` methods and the free functions
// are Rust's own std, reached through `rust.std`.

import rust.std.Error;
import rust.std.File;
import rust.std.PathBuf;
import rust.std.remove_file;
import rust.std.temp_dir;

void main() {
    // A path is not a string. The operating system has its own idea of what a
    // filename is (its own encoding, its own separator) so a path is built
    // with `PathBuf` rather than by gluing text together. The Path lesson goes
    // into why this matters. The file goes in the system's temporary
    // directory, so the lesson never writes into the project.
    final PathBuf path = temp_dir().join("rux-file-lesson.txt");

    try {
        // Opening says what is intended. `File.create` creates the file if it
        // is not there and truncates it if it is; `File.open` requires it to
        // exist and opens it for reading. The intent is part of the request
        // rather than something checked afterwards.
        var writing = File.create(path);

        // `write` reports how many bytes it took, because it is allowed to
        // take fewer than it was given. A program writing something large has
        // to loop until everything is gone (`write_all` is that loop); here
        // the count is printed instead.
        final uint taken = writing.write("first line\nsecond line\n".as_bytes());
        print($"wrote     ${taken} bytes");

        // A file is closed when the last reference to it goes. A failure the
        // system delayed would be lost then, so `sync_all` asks for it now.
        writing.sync_all();

        // Reading it back, through a fresh handle.
        var reading = File.open(path);

        // Read into a buffer of a size decided here. The count says how much
        // actually arrived, which is not necessarily the buffer's size, and
        // not necessarily the whole file either.
        var buffer = new ubyte[64];
        final uint filled = reading.read(buffer);
        print($"read      ${filled} bytes");

        // Only the part that was filled is real. The rest of the buffer is
        // whatever it was before, so only `filled` bytes are kept, and then
        // decoded as UTF-8, which can itself fail.
        var kept = new Vec<ubyte>();
        for (var i : 0..(int) filled) {
            kept.push(buffer[i]);
        }
        final String text = String.from_utf8(kept);
        print("contents:");
        print(text);

        // Tidy up, so running this twice behaves the same as running it once.
        remove_file(path);
        print("removed the file");
    } catch (Error failure) {
        print($"the round trip failed: ${failure}");
    }
}

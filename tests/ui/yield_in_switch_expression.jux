// Java's arm-value `yield`. Jux's `yield` belongs to generators (§M.2), so the
// arm is E0990 with the expression-body spelling as the fix. The E0410 is
// honest rather than noise: without a value the arm produces nothing.

public int pick(int n) {
    return switch (n) {
        case 1 -> { yield 10; }
        default -> 0;
    };
}

public void main() {
    print(pick(1));
}

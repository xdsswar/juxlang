record Point(int x, int y) {}
record Size(int w, int h) {}

public String describe(Point p) {
    return switch (p) {
        case Point(var x) -> "one component";
        case Size(var w, var h) -> "another record";
        case (var x, var y) -> "a tuple";
        case _ -> "anything";
    };
}

public String pair(int a, int b) {
    return switch ((a, b)) {
        case (1, 2, 3) -> "three";
        case _ -> "anything";
    };
}

public void main() { }

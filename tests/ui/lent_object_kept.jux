// A foreign object a crate lends to a lambda exists only while the crate's
// call runs; keeping it is E0454 (ERRATA E1XX-GAP30).

import rust.std.Once;
import rust.std.OnceState;

class Keeper {
    public OnceState? kept = null;
}

public void main() {
    var once = new Once();
    var keeper = new Keeper();
    once.call_once_force((state) -> {
        keeper.kept = state;
    });
}

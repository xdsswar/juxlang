// Keywords the language reserves and the spec documents, which Phase 1 does
// not implement. Each must produce ONE error that names the construct and
// says where it is written down -- not a cascade about whatever the parser
// tripped over next.
//
// `annotation` used to be here. It is implemented now (§A.2), so it moved to
// `examples/annotations_user.jux`, where it is exercised rather than refused.

public class Reg {
    public volatile int status;
    public Reg() { this.status = 0; }
}

public void take(int n) {
    print(n);
}

public void main() {
    var a = 1;
    take(move a);
}

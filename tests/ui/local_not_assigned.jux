// A local read before anything assigned it (§S.4.6). Each of these compiled
// before and printed the type's default -- a value the program never wrote.

public int straight() {
    int x;
    return x;
}

public int oneArmOnly(bool c) {
    int y;
    if (c) {
        y = 1;
    }
    return y;
}

public int loopMayNotRun(int n) {
    int z;
    for (int i = 0; i < n; i++) {
        z = i;
    }
    return z;
}

public String throughTheBinding() {
    String s;
    return s.toUpperCase();
}

public void main() {
    print(straight());
    print(oneArmOnly(true));
    print(loopMayNotRun(0));
    print(throughTheBinding());
}

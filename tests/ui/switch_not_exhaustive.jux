// A switch over a sealed set that leaves a case out, and a cast between types
// with no relationship.

enum Tier { Bronze, Silver, Gold }

class Cat { public int lives() { return 9; } }
class Rock { public int mass() { return 3; } }

public String describe(Tier t) {
    return switch (t) {
        case Tier.Bronze -> "low";
        case Tier.Silver -> "mid";
    };
}

public void main() {
    print(describe(Tier.Gold));
    Cat c = new Cat();
    Rock r = (Rock) c;
    print(r.mass());
}

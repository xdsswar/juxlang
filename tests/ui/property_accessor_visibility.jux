// A property's setter cannot be more visible than the property, and a
// `private set` is not reachable from outside the declaring class.

public class Account {
    public int Balance { get; private set; }
    private int Hidden { get; public set; }

    public Account() {
        this.Balance = 0;
        this.Hidden = 0;
    }
}

public void main() {
    var a = new Account();
    a.Balance = 10;
    print(a.Balance);
}

// An object shared with workers shares its collections too (JUX-LANG-V1
// §6.5.1, ERRATA E1XX-SWEEPA): a getter's result, a field bound to a local
// and a list read inside the class's own code are the object's own list, so
// writing one is writing the object, and none of it is an error any more
// (ERRATA E145 refused each of these writes as a write to a copy). The one
// copy left is the one §18.2 makes on purpose: a worker's own capture of a
// collection, which is still E0702 when written (ERRATA E144).
import rust.std.*;

class Registry {
    private Vec<String> log = new Vec<String>();
    public Vec<String> items = new Vec<String>();
    public void handle(String s) { this.log.push(s); }
    public Vec<String> getLog() { return this.log; }
    public Vec<String> fresh() { var v = new Vec<String>(); v.push("f"); return v; }
    public int count() { return this.log.len(); }
    public void selfAlias() { var mine = this.log; mine.push("kept"); }
}

public int work(Registry r) { r.handle("w"); return 1; }

public async void main() {
    var r = new Registry();
    var t = Worker.spawn(() -> work(r));
    await t;
    var l = r.getLog();
    print(l.len());
    l.push("x");
    r.getLog().push("y");
    var it = r.items;
    it.push("z");
    it[0] = "z2";
    r.items.push("in place");
    var f = r.fresh();
    f.push("ok");
    var c = r.getLog().clone();
    c.push("ok");
    var local = new Vec<String>();
    var copyWrite = Worker.spawn(() -> { local.push("lost"); return 0; });
    await copyWrite;
    print(r.count() + " " + r.items.len());
}

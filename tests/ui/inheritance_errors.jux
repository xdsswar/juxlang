// The `extends` / `implements` clauses naming the wrong kind of thing, and a
// `final` method overridden anyway.

interface Marker {
    int id();
}

final class Sealed {
    public final int size() { return 1; }
}

class Wrong extends Marker {
    public int id() { return 1; }
}

class AlsoWrong implements Sealed {
    public int size() { return 2; }
}

class Base {
    public final int size() { return 1; }
}

class Derived extends Base {
    public int size() { return 2; }
}

public void main() {
    print(new Derived().size());
}

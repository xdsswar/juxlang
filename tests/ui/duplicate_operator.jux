// Two methods of a name are an overload group; two operators of a KIND are
// not, because the operator IS the selector.

public class Money {
    private int cents;
    public Money(int cents) { this.cents = cents; }

    public Money operator+(Money other) {
        return new Money(this.cents + other.cents);
    }
    public Money operator+(Money twin) {
        return new Money(this.cents + twin.cents);
    }
}

public void main() {
    print(1);
}

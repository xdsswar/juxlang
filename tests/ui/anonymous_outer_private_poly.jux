// An anonymous class reaches the enclosing object's members through the
// handle it holds on it (ERRATA E1XX-GAP39d). In a class with subclasses
// that handle is the class's dispatch trait object, where a private member
// has no slot, so reaching one is refused at the anonymous class.
interface Listener { void on(int x); }

abstract class Panel {
    private int hits = 0;
    int shown = 0;
    abstract String name();
    Listener listener() {
        return new Listener() {
            public void on(int x) { hits += x; shown++; }
        };
    }
}

class Side extends Panel {
    String name() { return "side"; }
}

void main() {
    Panel p = new Side();
    p.listener().on(1);
}

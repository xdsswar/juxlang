// A subclass of a class whose only constructor takes arguments has to say
// which one it is calling.

public class Base {
    private int size;
    public Base(int size) { this.size = size; }
    public int size() { return this.size; }
}

public class Derived extends Base {
    private int extra;
    public Derived() {
        this.extra = 1;
    }
}

public void main() {
    print(new Derived().size());
}

// Polymorphic recursion -- a function calling itself at an ever-larger type
// argument -- is compiled by erasing the type arguments of the functions and
// classes on the cycle, and an erased value keeps each of its bounds as that
// bound's dispatch object (ERRATA E1XX-GAP39g, E1XX-GAP39h). A bound that
// names the type parameter itself (`T extends Ranked<T>`) is not one fixed
// type, so there is no one object to keep (E0438).
interface Ranked<T> { int rank(T other); }

class Level implements Ranked<Level> {
    int n;
    Level(int n) { this.n = n; }
    public int rank(Level other) { return n - other.n; }
}

class Up<T extends Ranked<T>> implements Ranked<Up<T>> {
    T inner;
    Up(T inner) { this.inner = inner; }
    public int rank(Up<T> other) { return inner.rank(other.inner); }
}

<T extends Ranked<T>> int climb(T a, T b, int n) {
    if (n == 0) { return a.rank(b); }
    return climb<Up<T>>(new Up<T>(a), new Up<T>(b), n - 1);
}

public void main() {
    print(climb<Level>(new Level(3), new Level(1), 3));
}

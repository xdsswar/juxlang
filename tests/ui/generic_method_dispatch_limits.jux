// Polymorphic recursion -- a function calling itself at an ever-larger type
// argument -- is compiled by erasing the type arguments of the functions and
// classes on the cycle (ERRATA E141). An erased value carries its
// own type but none of a bound's members, so a bounded type parameter on
// the cycle cannot be erased (E0438).
interface Named { String name(); }

class Tag implements Named {
    public String name() { return "tag"; }
}

class Wrap<T extends Named> implements Named {
    T inner;
    Wrap(T inner) { this.inner = inner; }
    public String name() { return "wrap(" + inner.name() + ")"; }
}

<T extends Named> String nest(T x, int n) {
    if (n == 0) { return x.name(); }
    return nest<Wrap<T>>(new Wrap<T>(x), n - 1);
}

public void main() {
    print(nest<Tag>(new Tag(), 3));
}

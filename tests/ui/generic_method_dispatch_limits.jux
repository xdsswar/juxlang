// Polymorphic recursion is compiled by erasing the type arguments of the
// functions and classes on the cycle; an erased value keeps each bound as a
// dispatch object, through an adapter when the bound names the parameter
// (`T extends Ranked<T>`), converting the erased value at each position
// (ERRATA E1XX-GAP39g .. E1XX-GAP39i). A position holding a Rust collection
// of the parameter (`Rel<Vec<T>>`) has no conversion that keeps the list
// shared, so that bound is refused (E0438).
import rust.std.Vec;

interface Rel<L> { int weigh(L list); }

class Item implements Rel<Vec<Item>> {
    int w;
    Item(int w) { this.w = w; }
    public int weigh(Vec<Item> list) { return w + (int) list.len(); }
}

class Crate<T extends Rel<Vec<T>>> implements Rel<Vec<Crate<T>>> {
    T inner;
    Crate(T inner) { this.inner = inner; }
    public int weigh(Vec<Crate<T>> list) { return 1 + (int) list.len(); }
}

<T extends Rel<Vec<T>>> int pack(T x, int n) {
    if (n == 0) { return x.weigh(new Vec<T>()); }
    return pack<Crate<T>>(new Crate<T>(x), n - 1);
}

public void main() {
    print(pack<Item>(new Item(4), 3));
}

// Polymorphic recursion is compiled by erasing the type arguments of the
// functions and classes on the cycle; an erased value keeps each bound as a
// dispatch object, through an adapter when the bound names the parameter
// (`T extends Ranked<T>`), converting the erased value at each position
// (ERRATA E1XX-GAP39g .. E143), and linking a collection of the parameter
// (`Rel<Vec<T>>`) so both sides share it (E144). A position holding
// the parameter inside a FOREIGN type that is neither a Jux class nor a
// collection (`Rel<Box<T>>`) has no conversion at all, so that bound is
// refused (E0438).
import rust.std.Box;

interface Rel<L> { int weigh(L b); }

class Item implements Rel<Box<Item>> {
    int w;
    Item(int w) { this.w = w; }
    public int weigh(Box<Item> b) { return w; }
}

class Crate<T extends Rel<Box<T>>> implements Rel<Box<Crate<T>>> {
    T inner;
    Crate(T inner) { this.inner = inner; }
    public int weigh(Box<Crate<T>> b) { return 1; }
}

<T extends Rel<Box<T>>> int pack(T x, int n) {
    if (n == 0) { return 0; }
    return pack<Crate<T>>(new Crate<T>(x), n - 1);
}

public void main() {
    print(pack<Item>(new Item(4), 3));
}

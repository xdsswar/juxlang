// A bound on a Rust type admits only that type: no Jux type can extend
// `rust.std.Vec`, so `V` could only ever be `Vec<Pair<K, T>>` (E0459).
import rust.std.Vec;
import rust.std.HashMap;

interface Named { String name(); }
interface Aged { int age(); }
class Pair<K, V> { public K k; public V v; public Pair(K k, V v) { this.k = k; this.v = v; } }

class Registry<T extends Named & Aged, K, V extends Vec<Pair<K, T>>> {
    HashMap<K, V> byKey = new HashMap<K, V>();
}

<M extends HashMap<String, int>> int size(M m) { return (int) m.len(); }

public void main() {}
